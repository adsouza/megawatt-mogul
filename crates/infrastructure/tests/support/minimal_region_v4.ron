            fixed_om_per_month: 600000,
            capital_cost: 600000000,
            build_months: 30,
            capacity_credit: 0.95,
            book_life_months: 360,
            siting: Anywhere,
        ),
        (
            kind: Peaker,
            capacity_mw: 200.0,
            min_stable: 0.2,
            ramp_mw_per_min: 40.0,
            startup_hours: 0.16666666666666666,
            startup_cost: 5000,
            marginal_cost_per_mwh: 150.0,
            fixed_om_per_month: 170000,
            capital_cost: 200000000,
            build_months: 12,
            capacity_credit: 0.95,
            book_life_months: 360,
            siting: Anywhere,
        ),
        (
            kind: Solar,
            capacity_mw: 300.0,
            min_stable: 0.0,
            ramp_mw_per_min: 300.0,
            startup_hours: 0.0,
            startup_cost: 0,
            marginal_cost_per_mwh: 0.0,
            fixed_om_per_month: 500000,
            capital_cost: 400000000,
            build_months: 12,
            capacity_credit: 0.3,
            book_life_months: 300,
            siting: Anywhere,
        ),
        (
            kind: Hydro,
            capacity_mw: 800.0,
            min_stable: 0.0,
            ramp_mw_per_min: 100.0,
            startup_hours: 0.08333333333333333,
            startup_cost: 1000,
            marginal_cost_per_mwh: 0.0,
            fixed_om_per_month: 2700000,
            capital_cost: 3000000000,
            build_months: 72,
            capacity_credit: 0.8,
            book_life_months: 600,
            siting: HydroSite(0.5),
        ),
        (kind: Battery, capacity_mw: 200.0, min_stable: 0.0, ramp_mw_per_min: 0.0,
         startup_hours: 0.0, startup_cost: 0, marginal_cost_per_mwh: 0.0,
         fixed_om_per_month: 100000, capital_cost: 100000000, build_months: 2,
         capacity_credit: 0.0, book_life_months: 180, siting: Anywhere,
         battery: Some((charge_mw: 200.0, energy_mwh: 800.0, charge_efficiency: 0.9,
                        discharge_efficiency: 1.0, discharge_start_hour: 16, charge_end_hour: 18))),
    ],
    cities: [
        (id: 1, name_key: "city-tiny-1", lon: 6.5, lat: 3.5, zone: 7, climate: 10, base_load_mw: 600.0),
        (id: 2, name_key: "city-tiny-2", lon: 8.5, lat: 1.5, zone: 8, climate: 20, base_load_mw: 400.0),
        (id: 3, name_key: "city-tiny-3", lon: 3.5, lat: 5.5, zone: 7, climate: 10, base_load_mw: 300.0),
    ],

    solar: (
        clearness_mean: [0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75, 0.75],
        clearness_sd: 0.15,
    ),
    hydro: (monthly_flow: [0.6, 0.6, 0.9, 1.2, 1.4, 1.3, 1.0, 0.8, 0.7, 0.6, 0.6, 0.6]),
    frequency: (
        nominal_hz: 60.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        starting_tariff_per_mwh: 95.0,
        reference_tariff_per_mwh: 100.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
        reliability_target: 0.999,
        return_per_reliability: 2.0,
        return_per_cost_improvement: 0.05,
        reserve_margin: 0.2,
        strike_threshold: 0.005,
        strikes_to_revoke: 3,
        clean_months_to_expire: 3,
        frequency_band_hz: 0.2,
        frequency_violation_share: 0.05,
    ),
    satisfaction: (
        starting: 70.0,
        reliability_floor: 0.95,
        price_sensitivity: 2.0,
        smoothing: 0.2,
    ),
    lines: (cost_per_cell: 40000000, cells_per_month: 2, book_life_months: 600),
    start: (
        year: 2027,
        month: 4,
        cash: 2000000000,
        line_names: [(2, "line-starter")],
        home_city: 1,
        connected_cities: [1, 2],
        fleet: [(Coal, 7.5, 4.5), (Ccgt, 8.5, 3.5), (Peaker, 6.5, 2.5)],
