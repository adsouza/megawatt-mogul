                1.01, 1.02, 1.03, 1.03, 1.04, 1.07, 1.13, 1.15, 1.10, 1.01, 0.91, 0.83,
            ]),
            ],
            month_shapes: ["winter", "winter", "shoulder", "shoulder", "shoulder", "summer", "summer", "summer", "shoulder", "shoulder", "shoulder", "winter"],
            monthly: [1.06, 0.96, 0.98, 0.95, 0.96, 0.99, 1.04, 1.04, 0.98, 0.96, 1.00, 1.06],
