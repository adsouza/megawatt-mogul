// Southern China: the main synchronous area of China Southern Power Grid
// (CSG): Guangdong, Guangxi, Guizhou and Hainan, with Hong Kong and Macau
// (spec section 28.3; research note
// docs/research/2026-10-18-world-power-grids-top-8.md, section "E - Southern
// China main area"). Yunnan, CSG's fifth province, is excluded: the notes
// record that it has run asynchronously from the four-province area since
// 2016, joined only by DC links.
//
// Grid-operation rulings, all from that section of the notes: Hong Kong and
// Macau are AC-connected to Guangdong, so they belong here (their generation
// counted once); Hainan joins Guangdong by existing AC submarine connections
// across the Qiongzhou Strait, so it is in (the notes cite CSG's Hainan AC
// procurement). The footprint contains no disputed area that the notes leave
// open.
//
// Geography: tools/region_authoring/selections/southern_china.args holds the
// extractor arguments. Natural Earth v5.1.2, 1:10m admin-1 Guangdong,
// Guangxi, Guizhou, Hainan, the 18 Hong Kong districts and Macau, dissolved.
// Ruling 22: the 1:10m admin-1 features replace admin-0 HKG and MAC, whose
// 1:50m outlines share no vertices with the 1:10m Guangdong border, so
// dissolving them left a sliver of water through Shenzhen. Features used:
// admin-1 CHN Guangdong, Guangxi, Guizhou and Hainan; MAC Macau; HKG Central
// and Western, Eastern, Islands, Kowloon City, Kwai Tsing, Kwun Tong, North,
// Sai Kung, Sha Tin, Sham Shui Po, Southern, Tai Po, Tsuen Wan, Tuen Mun,
// Wan Chai, Wong Tai Sin, Yau Tsim Mong and Yuen Long. Regenerate with
//   tr '\n' '\0' < tools/region_authoring/selections/southern_china.args \
//       | xargs -0 python3 -I tools/region_authoring/natural_earth.py
// which reports 2 land and 0 exclude rings (the selection has no
// exclusions). The extractor drops Macau's outline (under 2 cells), and the
// half-cell simplification moves the Haikou, Shantou and Yangjiang shores off
// their cell centres, so four short nudge rings after the generated rings
// put those coastal cities on land. Points are (lon, lat) in degrees.
//
// Grid: 104 to 117.5 E and 18 to 29.5 N on 124 x 115 cells. The 104.0 E west
// bound clips far-western Guizhou (about 103.6 to 104.0 E). At the middle
// latitude, 23.75 N, a cell is 11.08 km east-west by 11.12 km north-south
// (aspect 1.004, cell_km 11.100).
//
// Money is in CNY (yuan) at local price levels from the Plan 7 research note
// (docs/research/2026-10-25-plan-7-regional-economics.md), converted to game
// values by its pacing method. Each entry's comment cites its rows and shows
// the arithmetic; the ratios use full precision.
(
    region_schema: 4,
    id: "southern_china",
    system_zone: 1,
    // China Standard Time, UTC+8 with no daylight saving, for every city,
    // Hong Kong and Macau included (spec section 28.4).
    time_zones: [
        (id: 1, name_key: "zone-cst", standard_offset_minutes: 480, dst_months: [false, false, false, false, false, false, false, false, false, false, false, false]),
    ],
    // Northern meteorological seasons.
    calendar: (seasons: [Winter, Winter, Spring, Spring, Spring, Summer, Summer, Summer, Autumn, Autumn, Autumn, Winter]),
    currency: CNY,
    atlas: (colour: "#008F9D"),
    name_key: "region-southern-china",
    bounds: (west: 104.0, east: 117.5, south: 18.0, north: 29.5),
    grid: (width: 124, height: 115),
    // Generated rings (spec section 28.11.1): natural_earth.ron, written by
    // tools/region_authoring/selections/southern_china.args, whose header records the source
    // data and command.
    geography: ["natural_earth.ron"],
    land: [
        // Nudge rings (hand-authored, not generated). Macau: the peninsula,
        // Taipa, Coloane and the Hengqin shore, which the extractor drops
        // as under 2 cells.
        [
            (113.500, 22.130), (113.520, 22.220), (113.560, 22.220), (113.600, 22.160),
            (113.590, 22.110), (113.540, 22.100),
        ],
        // Haikou, on Hainan's north shore.
        [
            (110.200, 19.950), (110.200, 20.100), (110.550, 20.100), (110.550, 19.950),
        ],
        // Shantou, at the mouth of the Rong and Han rivers.
        [
            (116.600, 23.300), (116.600, 23.420), (116.780, 23.420), (116.780, 23.300),
        ],
        // Yangjiang, on the west Guangdong coast.
        [
            (111.920, 21.800), (111.920, 21.920), (112.080, 21.920), (112.080, 21.800),
        ],
    ],
    exclude: [],
    // Relief: the Yunnan-Guizhou Plateau rising west through Guizhou to the
    // Wumeng Mountains, the Guangxi karst hills, the Nanling ranges along
    // the northern edge of Guangdong and Guangxi, the Yunkai and Lianhua
    // mountains, and Hainan's Wuzhi Mountains; the Pearl River Delta, the
    // Chaoshan plain and the Leizhou Peninsula are low. Named ranges only;
    // heights are an authoring judgment (no elevation dataset was used).
    height: (
        base: 0.2,
        blobs: [
            // The Yunnan-Guizhou Plateau and the Wumeng Mountains.
            (lon: 106.6, lat: 26.8, radius_deg: 1.5, value: 0.35),
            (lon: 105.0, lat: 26.7, radius_deg: 1.0, value: 0.45),
            (lon: 105.3, lat: 25.3, radius_deg: 0.9, value: 0.35),
            // The Guangxi karst hills and the Nanling ranges.
            (lon: 108.6, lat: 24.8, radius_deg: 1.1, value: 0.25),
            (lon: 110.8, lat: 25.6, radius_deg: 0.9, value: 0.3),
            (lon: 113.0, lat: 24.9, radius_deg: 1.0, value: 0.3),
            (lon: 114.8, lat: 24.6, radius_deg: 0.8, value: 0.2),
            // The Yunkai and Lianhua mountains.
            (lon: 111.4, lat: 22.6, radius_deg: 0.6, value: 0.2),
            (lon: 115.5, lat: 23.6, radius_deg: 0.6, value: 0.2),
            // Hainan's Wuzhi Mountains.
            (lon: 109.6, lat: 18.9, radius_deg: 0.5, value: 0.35),
            // Lowlands: the Pearl River Delta, the Chaoshan plain and the
            // Leizhou Peninsula.
            (lon: 113.4, lat: 22.8, radius_deg: 0.6, value: -0.15),
            (lon: 116.5, lat: 23.4, radius_deg: 0.4, value: -0.1),
            (lon: 110.1, lat: 20.9, radius_deg: 0.5, value: -0.1),
        ],
    ),
    // Sunshine as site quality without latitude (spec section 28.5). The
    // base, 0.55, is the authoring scale for the Pearl River Delta (near the
    // North American files' medians); Hong Kong's King's Park records 13.23
    // MJ/m2 a day of global radiation (Hong Kong Observatory, "Climatological
    // Normals 1991-2020", Table 6, hko.gov.hk/en/cis/normal/1991_2020).
    // Guizhou: Guiyang records 10.3 MJ/m2 a day (UNESCO-IHP Catalogue of
    // Rivers for Southeast Asia and the Pacific, vol. 4, "Hongshuihe", China-11,
    // section 3.3, p. 18, 1982-1985), 0.78 of King's Park, so 0.55 x 0.78 =
    // 0.43 at the centre. Hainan: 5,145 to 6,113 MJ/m2 a year, 14.1 to 16.7 a
    // day (Journal of Hainan University, Natural Science, 2007(3), doi
    // 10.15886/j.cnki.hdxbzkb.2007.03.014, Haikou and Sanya 1992-2003), a
    // midpoint 1.17 of King's Park, so 0.64. No other site difference was
    // sourced.
    irradiance: (
        base: 0.55,
        blobs: [
            (lon: 106.5, lat: 26.8, radius_deg: 1.6, value: -0.12),
            (lon: 109.6, lat: 18.9, radius_deg: 1.0, value: 0.09),
        ],
    ),
    // Water for thermal plants: the whole coast from the Beibu Gulf to
    // Chaoshan, the Pearl River estuary and Daya Bay (the coastal nuclear
    // sites), Hainan's shores, and the big rivers inland: the Xi, Bei and
    // Yong, the Hongshui and the Wujiang. Blobs sit on the Natural Earth
    // coastline and the named rivers (authoring judgment; no water-
    // availability dataset was used).
    cooling_water: (
        base: 0.08,
        blobs: [
            // The Beibu Gulf and the Leizhou Peninsula.
            (lon: 108.3, lat: 21.6, radius_deg: 0.4, value: 0.7),
            (lon: 108.7, lat: 21.75, radius_deg: 0.4, value: 0.7),
            (lon: 109.2, lat: 21.5, radius_deg: 0.4, value: 0.7),
            (lon: 109.8, lat: 21.5, radius_deg: 0.4, value: 0.7),
            (lon: 110.0, lat: 20.9, radius_deg: 0.4, value: 0.7),
            (lon: 110.4, lat: 21.2, radius_deg: 0.4, value: 0.7),
            (lon: 110.4, lat: 20.5, radius_deg: 0.4, value: 0.7),
            // West Guangdong: Maoming, Yangjiang and Taishan.
            (lon: 111.0, lat: 21.5, radius_deg: 0.4, value: 0.7),
            (lon: 111.6, lat: 21.65, radius_deg: 0.4, value: 0.7),
            (lon: 112.1, lat: 21.8, radius_deg: 0.4, value: 0.7),
            (lon: 112.7, lat: 21.9, radius_deg: 0.4, value: 0.7),
            // The Pearl River estuary, Shenzhen and Daya Bay.
            (lon: 113.2, lat: 22.2, radius_deg: 0.4, value: 0.7),
            (lon: 113.6, lat: 22.45, radius_deg: 0.4, value: 0.7),
            (lon: 113.65, lat: 22.8, radius_deg: 0.4, value: 0.7),
            (lon: 114.0, lat: 22.45, radius_deg: 0.4, value: 0.7),
            (lon: 114.5, lat: 22.6, radius_deg: 0.4, value: 0.7),
            // East Guangdong: Shanwei, Shantou and Chaozhou.
            (lon: 115.1, lat: 22.8, radius_deg: 0.4, value: 0.7),
            (lon: 115.7, lat: 22.85, radius_deg: 0.4, value: 0.7),
            (lon: 116.3, lat: 23.0, radius_deg: 0.4, value: 0.7),
            (lon: 116.7, lat: 23.35, radius_deg: 0.4, value: 0.7),
            (lon: 117.1, lat: 23.65, radius_deg: 0.4, value: 0.7),
            // Hainan's coast.
            (lon: 110.35, lat: 20.0, radius_deg: 0.4, value: 0.7),
            (lon: 110.9, lat: 19.6, radius_deg: 0.4, value: 0.7),
            (lon: 110.4, lat: 18.7, radius_deg: 0.4, value: 0.7),
            (lon: 109.5, lat: 18.3, radius_deg: 0.4, value: 0.7),
            (lon: 108.7, lat: 18.8, radius_deg: 0.4, value: 0.7),
            (lon: 109.2, lat: 19.8, radius_deg: 0.4, value: 0.7),
            // The Xi (Xijiang) and Bei rivers, with the delta channels at
            // Foshan (Hengyi's site).
            (lon: 112.5, lat: 23.05, radius_deg: 0.35, value: 0.6),
            (lon: 112.85, lat: 23.0, radius_deg: 0.25, value: 0.6),
            (lon: 111.3, lat: 23.45, radius_deg: 0.35, value: 0.6),
            (lon: 110.3, lat: 23.4, radius_deg: 0.35, value: 0.6),
            (lon: 109.6, lat: 23.1, radius_deg: 0.35, value: 0.6),
            (lon: 113.2, lat: 23.8, radius_deg: 0.35, value: 0.6),
            // The Yong at Nanning, the Liu at Liuzhou and the Hongshui.
            (lon: 108.4, lat: 22.8, radius_deg: 0.35, value: 0.6),
            (lon: 109.4, lat: 24.3, radius_deg: 0.35, value: 0.6),
            (lon: 107.6, lat: 24.4, radius_deg: 0.35, value: 0.6),
            // The Wujiang across Guizhou.
            (lon: 105.9, lat: 26.8, radius_deg: 0.35, value: 0.6),
            (lon: 106.7, lat: 27.3, radius_deg: 0.35, value: 0.6),
            (lon: 107.6, lat: 27.4, radius_deg: 0.35, value: 0.6),
        ],
    ),
    // Hydro sites at real dams (English Wikipedia infobox coordinates unless
    // noted): Longtan (Hongshui), Tianshengqiao-I (Nanpan), Guangzhao
    // (Beipan), Hongjiadu (Liuchong), Dongfeng, Wujiangdu and Goupitan (Wu),
    // Baise (You); Datengxia (Qian; Global Energy Monitor wiki, "Datengxia
    // hydroelectric plant"), Changzhou (Xi; English Wikipedia "List of major
    // power stations in Guangxi") and Feilaixia (Bei; Global Energy Monitor
    // wiki, "Feilaixia hydroelectric plant"). Values rank them by size.
    hydro_potential: (
        base: 0.0,
        blobs: [
            (lon: 107.0475, lat: 25.0272, radius_deg: 0.35, value: 0.95),
            (lon: 105.1069, lat: 24.9414, radius_deg: 0.35, value: 0.9),
            (lon: 105.2508, lat: 25.9594, radius_deg: 0.3, value: 0.8),
            (lon: 105.8589, lat: 26.8697, radius_deg: 0.3, value: 0.8),
            (lon: 106.155, lat: 26.8553, radius_deg: 0.3, value: 0.7),
            (lon: 106.7608, lat: 27.3194, radius_deg: 0.3, value: 0.8),
            (lon: 107.6331, lat: 27.3753, radius_deg: 0.35, value: 0.9),
            (lon: 106.4558, lat: 23.9261, radius_deg: 0.3, value: 0.6),
            (lon: 110.0308, lat: 23.4579, radius_deg: 0.3, value: 0.7),
            (lon: 111.204, lat: 23.42, radius_deg: 0.3, value: 0.6),
            (lon: 113.2588, lat: 23.7994, radius_deg: 0.25, value: 0.5),
        ],
    ),
    // Wind sites: the exposed coast is far windier than the shelter of the
    // delta (Waglan Island 22.9 km/h against the Observatory's 9.9, Hong
    // Kong Observatory 1991-2020 normals, Table 7). The two coastal blobs mark
    // Guangdong's offshore wind development areas: Chaozhou-Shantou
    // (Guangdong East Sites 6 and 7, Enerdata daily news, 2022-10-25) and
    // Yangjiang (CnEVPost, 2021-10-25). Inland wind sites were not sourced.
    wind_potential: (
        base: 0.3,
        blobs: [
            (lon: 116.5, lat: 23.2, radius_deg: 0.8, value: 0.35),
            (lon: 111.9, lat: 21.75, radius_deg: 0.6, value: 0.3),
        ],
    ),
    // The northeast monsoon blows hardest from October to January, and
    // August is the calmest month: each month's factor is Waglan Island's
    // mean wind speed over its annual mean (Hong Kong Observatory 1991-2020
    // normals, Table 7: 25.1, 24.2, 23.0, 20.5, 19.8, 21.6, 21.3, 18.8, 21.4,
    // 26.3, 26.6 and 26.4 km/h; year 22.9) times the Eastern
    // Interconnection's annual mean factor, 0.567 (authoring scale).
    wind: (monthly: [0.62, 0.6, 0.57, 0.51, 0.49, 0.53, 0.53, 0.47, 0.53, 0.65, 0.66, 0.65], persistence: 0.995, innovation_sd: 0.015, initial_sd: 0.15, band: 0.25),
    // Unit sizes and operating parameters follow the North American
    // catalog (spec section 3.2), except coal: Guangdong builds 1,000 MW
    // ultra-supercritical units [P7-SC-003]. Money and build months come from
    // the Plan 7 research note by its pacing method (ratios from its pacing
    // table, at full precision; game values rounded to 3 significant figures
    // per kW, then multiplied by capacity). Build months: no Southern China
    // row gives an observed construction duration (the note's Gaps), so
    // every kind inherits the North American game months (ruling 1,
    // authoring judgment: no sourced local duration). [P7-SC-004] is a
    // planned approval-to-target window of 27 months, which would pace coal
    // at 27 x 0.2222 = 6 months; it is recorded, not used.
    // Fuel (ruling 19, authoring judgment: no sourced local fuel row): each
    // marginal cost is the North American game marginal x the local game
    // reference tariff over the NA one, 501.378 / 100 = 5.01378, a price-level
    // proxy from [P7-SC-005].
    // Start-ups follow ruling 2 (NA start-up x local marginal / NA marginal);
    // fixed O&M follows ruling 4 (local capital x the NA fixed O&M /
    // capital ratio), both authoring judgments derived from these rows.
    catalog: [
        // Wind [P7-SC-001] [P7-US-001]: 4,100 CNY/kW x (1,000 / 1,489 =
        // 0.67159) = 2,753.5, so 2,750 CNY/kW x 300,000 kW = 825,000,000.
        // Fixed O&M (ruling 4): 825,000,000 x (500,000 / 300,000,000) =
        // 1,375,000, so 1,380,000. Build 3 months (ruling 1).
        (kind: Wind, capacity_mw: 300.0, min_stable: 0.0, ramp_mw_per_min: 0.0, startup_hours: 0.0, startup_cost: 0, marginal_cost_per_mwh: 0.0, fixed_om_per_month: 1380000, capital_cost: 825000000, build_months: 3, capacity_credit: 0.2, book_life_months: 300, siting: Anywhere),
        // Nuclear (Daya Bay, Ling Ao and Taishan are the coastal fleet).
        // Capital (ruling 3, authoring judgment: derived from [P7-SC-003] by
        // NA kind relativity): local game coal 1,109.88 CNY/kW x NA nuclear
        // / coal (2,181.82 / 1,166.67 = 1.87013) = 2,075.6, so 2,080 CNY/kW
        // x 1,100,000 kW = 2,288,000,000. Fixed O&M (ruling 4):
        // 2,288,000,000 x (11,000,000 / 2,400,000,000) = 10,486,667, so
        // 10,500,000. Marginal (ruling 19): 10 x 5.01378 = 50.1
        // [P7-SC-005]. Start-up (ruling 2): 1,000,000 x 50.1 / 10 =
        // 5,010,000. Build 18 months (ruling 1).
        (
            kind: Nuclear,
            capacity_mw: 1100.0,
            min_stable: 0.7,
            ramp_mw_per_min: 5.0,
            startup_hours: 48.0,
            startup_cost: 5010000,
            marginal_cost_per_mwh: 50.1,
            fixed_om_per_month: 10500000,
            capital_cost: 2288000000,
            build_months: 18,
            capacity_credit: 0.95,
            book_life_months: 480,
            siting: CoolingWater(0.5),
        ),
        // Coal [P7-SC-003] [P7-US-007]: 7.80656e9 CNY / 2,000,000 kW =
        // 3,903.28 CNY/kW x (1,166.67 / 4,103 = 0.28434) = 1,109.88, so
        // 1,110 CNY/kW x 1,000,000 kW = 1,110,000,000. Fixed O&M (ruling 4):
        // 1,110,000,000 x (2,000,000 / 700,000,000) = 3,171,429, so
        // 3,170,000. Marginal (ruling 19): 30 x 5.01378 = 150.4, so 150
        // [P7-SC-005]. Start-up (ruling 2, per MW because the unit is 1,000 MW rather
        // than 600): 150,000 / 600 MW x 1,000 MW x 150 / 30 = 1,250,000.
        // Build 8 months (ruling 1).
        (
            kind: Coal,
            capacity_mw: 1000.0,
            min_stable: 0.4,
            ramp_mw_per_min: 10.0,
            startup_hours: 8.0,
            startup_cost: 1250000,
            marginal_cost_per_mwh: 150.0,
            fixed_om_per_month: 3170000,
            capital_cost: 1110000000,
            build_months: 8,
            capacity_credit: 0.95,
            book_life_months: 480,
            siting: CoolingWater(0.5),
        ),
        // Combined cycle. Capital (ruling 3, authoring judgment: derived from
        // [P7-SC-003] by NA kind relativity): 1,109.88 x NA CCGT / coal
        // (600 / 1,166.67 = 0.51429) = 570.8, so 571 CNY/kW x 500,000 kW =
        // 285,500,000. Fixed O&M (ruling 4): 285,500,000 x (600,000 /
        // 300,000,000) = 571,000. Marginal (ruling 19): 45 x 5.01378 =
        // 225.6, so 226 [P7-SC-005]. Start-up (ruling 2): 40,000 x 226 / 45 =
        // 200,889, so 201,000. Build 4 months (ruling 1).
        (
            kind: Ccgt,
            capacity_mw: 500.0,
            min_stable: 0.3,
            ramp_mw_per_min: 25.0,
            startup_hours: 2.0,
            startup_cost: 201000,
            marginal_cost_per_mwh: 226.0,
            fixed_om_per_month: 571000,
            capital_cost: 285500000,
            build_months: 4,
            capacity_credit: 0.95,
            book_life_months: 360,
            siting: Anywhere,
        ),
        // Peaker. Capital (ruling 3, authoring judgment: derived from
        // [P7-SC-003] by NA kind relativity, through the CCGT): 570.79 x NA
        // peaker / CCGT (500 / 600 = 0.83333) = 475.7, so 476 CNY/kW x
        // 200,000 kW = 95,200,000. Fixed O&M (ruling 4): 95,200,000 x
        // (170,000 / 100,000,000) = 161,840, so 162,000. Marginal (ruling
        // 19): 150 x 5.01378 = 752.1, so 752 [P7-SC-005]. Start-up (ruling 2):
        // 5,000 x 752 / 150 = 25,067, so 25,100. Build 2 months (ruling 1).
        (
            kind: Peaker,
            capacity_mw: 200.0,
            min_stable: 0.2,
            ramp_mw_per_min: 40.0,
            startup_hours: 0.16666666666666666,
            startup_cost: 25100,
            marginal_cost_per_mwh: 752.0,
            fixed_om_per_month: 162000,
            capital_cost: 95200000,
            build_months: 2,
            capacity_credit: 0.95,
            book_life_months: 360,
            siting: Anywhere,
        ),
        // Solar [P7-SC-002] [P7-US-016]: 3,200 CNY/kW x (500 / 1,502 =
        // 0.33289) = 1,065.2, so 1,070 CNY/kW x 300,000 kW = 321,000,000.
        // Fixed O&M (ruling 4): 321,000,000 x (500,000 / 150,000,000) =
        // 1,070,000. Build 2 months (ruling 1).
        (
            kind: Solar,
            capacity_mw: 300.0,
            min_stable: 0.0,
            ramp_mw_per_min: 300.0,
            startup_hours: 0.0,
            startup_cost: 0,
            marginal_cost_per_mwh: 0.0,
            fixed_om_per_month: 1070000,
            capital_cost: 321000000,
            build_months: 2,
            capacity_credit: 0.3,
            book_life_months: 300,
            siting: Anywhere,
        ),
        // Hydro [P7-SC-006] [P7-US-019] [P7-FX-020]: 2,302 USD/kW x 7.189847
        // = 16,551 CNY/kW x (1,500 / 7,073 = 0.21207) = 3,510.0, so 3,510
        // CNY/kW x 800,000 kW = 2,808,000,000. Fixed O&M (ruling 4):
        // 2,808,000,000 x (2,700,000 / 1,200,000,000) = 6,318,000, so
        // 6,320,000. Start-up (ruling 2 with the hydro judgment: the CCGT
        // marginal ratio): 1,000 x 226 / 45 = 5,022, so 5,020. Build 12
        // months (ruling 1).
        (
            kind: Hydro,
            capacity_mw: 800.0,
            min_stable: 0.0,
            ramp_mw_per_min: 100.0,
            startup_hours: 0.08333333333333333,
            startup_cost: 5020,
            marginal_cost_per_mwh: 0.0,
            fixed_om_per_month: 6320000,
            capital_cost: 2808000000,
            build_months: 12,
            capacity_credit: 0.8,
            book_life_months: 600,
            siting: HydroSite(0.5),
        ),
        // Storage, standing in for pumped hydro such as the Guangzhou and
        // Huizhou pumped-storage stations. Capital (ruling 3, authoring
        // judgment: derived from [P7-SC-002] by NA kind relativity): local
        // game solar 1,065.25 CNY/kW x NA battery / solar (500 / 500 = 1) =
        // 1,065.2, so 1,070 CNY/kW x 200,000 kW = 214,000,000. Fixed O&M
        // (ruling 4): 214,000,000 x (100,000 / 100,000,000) = 214,000. Build 2
        // months (ruling 1). Windows on the CST system clock (spec section
        // 28.4): the starter territory's net load (it has no solar) is
        // highest from the summer afternoon plateau, 14:00 to 17:00, through
        // the winter evening peak at 19:00 to 20:00, so discharge may start at
        // 14:00; charging fills the night and morning valley before then.
        (kind: Battery, capacity_mw: 200.0, min_stable: 0.0, ramp_mw_per_min: 0.0,
         startup_hours: 0.0, startup_cost: 0, marginal_cost_per_mwh: 0.0,
         fixed_om_per_month: 214000, capital_cost: 214000000, build_months: 2,
         capacity_credit: 0.0, book_life_months: 180, siting: Anywhere,
         battery: Some((charge_mw: 200.0, energy_mwh: 800.0, charge_efficiency: 0.9,
                        discharge_efficiency: 1.0, discharge_start_hour: 14, charge_end_hour: 14))),
