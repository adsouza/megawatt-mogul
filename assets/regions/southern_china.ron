                1.02, 1.08, 1.11, 1.11, 1.09, 1.05, 1.07, 1.10, 1.07, 1.00, 0.91, 0.84,
            ]),
            ],
            month_shapes: ["winter", "winter", "shoulder", "shoulder", "summer", "summer", "summer", "summer", "summer", "shoulder", "shoulder", "winter"],
            monthly: [0.88, 0.84, 0.92, 0.96, 1.03, 1.10, 1.15, 1.15, 1.10, 1.02, 0.96, 0.93],
        ),
        (id: 2,
            shapes: [
                ("winter", [
                0.78, 0.74, 0.72, 0.71, 0.72, 0.76, 0.86, 0.96, 1.03, 1.05, 1.05, 1.03,
                1.00, 0.99, 0.98, 0.99, 1.03, 1.12, 1.20, 1.20, 1.14, 1.05, 0.94, 0.85,
