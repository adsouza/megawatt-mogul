    ],
    demand_noise: (forecast_error: 0.03, error_persistence: 0.995),
    // Regional cloud from the Hong Kong Observatory's 1991-2020 normals
    // (Table 6, percentage of possible sunshine at King's Park: 43, 32, 27,
    // 30, 34, 36, 48, 46, 47, 55, 52 and 48), through the Angstrom-Prescott
    // relation with the FAO-56 defaults (Allen et al., FAO Irrigation and
    // Drainage Paper 56, 1998, equation 35: a = 0.25, b = 0.50), normalised to
    // clear sky (0.75): (0.25 + 0.5 x share) / 0.75. The drizzly spring is the
    // cloudiest, October the clearest.
    solar: (
        clearness_mean: [0.62, 0.55, 0.51, 0.53, 0.56, 0.57, 0.65, 0.64, 0.65, 0.70, 0.68, 0.65],
        clearness_sd: 0.13,
    ),
    // Usable river flow on the Hongshui, the Xi's upper stem (UNESCO-IHP
    // Catalogue of Rivers, vol. 4, "Hongshuihe", China-11): 80% of the basin's
    // rain falls from May to October (sections 1 and 5.1, pp. 15 and 23);
    // Qianjiang's annual maximum falls in June to September and its minimum
    // in February to May in every year of 1952-1984, mostly March or April
    // (section 4.6, p. 22). The monthly factors are an authoring judgment on
    // that shape (no monthly discharge table was found), damped because the
    // cascade's regulating reservoirs (Tianshengqiao, Longtan) carry flood
    // water into the dry season (section 5.1).
    hydro: (monthly_flow: [0.6, 0.55, 0.52, 0.62, 0.95, 1.55, 1.7, 1.6, 1.25, 0.95, 0.78, 0.65]),
    // North American protection and performance values at 50 Hz (Global
    // Constraints).
    frequency: (
        nominal_hz: 50.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    // Currency-neutral ratios as in North America; only the two tariffs are
    // local.
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        // Tariffs [P7-SC-005] [P7-US-034]: 679.869 CNY/MWh x (95 / 135.6 =
        // 0.70059) = 476.3, so 476 to start, and x (100 / 135.6 = 0.73746) =
        // 501.4, so a reference of 501 (the same 0.95 relation as shipped).
        starting_tariff_per_mwh: 476.0,
        reference_tariff_per_mwh: 501.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
        reliability_target: 0.999,
        return_per_reliability: 2.0,
        return_per_cost_improvement: 0.05,
        reserve_margin: 0.2,
        strike_threshold: 0.005,
        strikes_to_revoke: 3,
        clean_months_to_expire: 3,
        frequency_band_hz: 0.2,
        frequency_violation_share: 0.05,
    ),
    satisfaction: (
        starting: 70.0,
        reliability_floor: 0.95,
        price_sensitivity: 2.0,
        smoothing: 0.2,
    ),
    // Lines. Cost (ruling 20, authoring judgment: derived from [P7-SC-003]
    // by NA kind relativity): local game coal 1,109.88 CNY/kW x the NA line
    // cost per km over NA coal per kW (466,832 / 1,166.67 = 400.14, the NA
    // line figure from the [P7-US-033] pacing table) = 444,108, so 444,000
    // CNY/km x cell_km 11.100 = 4,928,432 CNY per cell. Build speed (rulings
    // 5 and 21, authoring judgment: cell width is the note's cell_km): 201.07
    // km per month / 11.100 km = 18.1, so 18 cells per month.
    lines: (cost_per_cell: 4928432, cells_per_month: 18, book_life_months: 600),
    // The Pearl River Delta core: Guangzhou, Foshan and Dongguan.
    start: (
        year: 2027,
        month: 1,
        // Cash (tuned freely; scale from [P7-SC-003]): the Eastern
        // Interconnection's 5,000,000,000 x the local coal capital
        // relativity (1,109.88 / 1,166.67 = 0.95132) = 4,756,617,109, so
        // 4,760,000,000 CNY.
        cash: 4760000000,
        // Guangzhou anchors the starting service territory.
        home_city: 1,
        connected_cities: [1, 2, 3],
        // Real plants at their published coordinates. Thermal sites: English
        // Wikipedia, "List of major power stations in Guangdong" (coal, gas,
        // nuclear and pumped-storage tables, read 2026-10-25). Dams: each
        // dam's English Wikipedia infobox. Each plant's cell is land.
        fleet: [
            // Coastal nuclear: Daya Bay, Shenzhen (2 x 900 MW).
            (Nuclear, 114.5444, 22.5972),
            // Coal: Hengyi, Foshan (2 x 600 MW). Shajiao (Humen, 22.7472 N,
            // 113.6775 E) falls in a Pearl River water cell at this grid.
            (Coal, 112.8406, 23.0164),
            // Combined cycle: Zengcheng (Guangzhou, 2 x 650 MW), Datang
            // Foshan (2 x 400 MW), Gaobu (Dongguan, 2 x 470 MW) and Huizhou
            // LNG (3 x 390 and 3 x 460 MW). Yuhua Huangpu (23.0789 N,
            // 113.5006 E) falls in a river water cell.
            (Ccgt, 113.6769, 23.1714),
            (Ccgt, 112.8136, 22.9075),
            (Ccgt, 113.7544, 23.1269),
            (Ccgt, 114.6147, 22.7594),
            // West-to-East power: hydro at Longtan (Hongshui, 6,426 MW),
            // Tianshengqiao-I (Nanpan, 1,200 MW), Hongjiadu (Liuchong, 600 MW)
            // and Goupitan (Wu, 3,000 MW), carried east to the delta.
            (Hydro, 107.0475, 25.0272),
            (Hydro, 105.1069, 24.9414),
            (Hydro, 105.8589, 26.8697),
            (Hydro, 107.6331, 27.3753),
            // Peaking gas: each 200 MW peaker stands for a station's small
            // 180-183 MW gas units: Dongguan Zhongdian, Datang Baocang
            // (Shenzhen), Dongguan Zhangyang and Nanshan (Shenzhen).
            (Peaker, 113.8289, 22.9764),
            (Peaker, 114.0269, 22.7075),
            (Peaker, 114.0942, 22.8875),
            (Peaker, 113.8925, 22.5125),
            // Pumped storage: the Guangdong (Guangzhou) Pumped Storage Power
            // Station at Conghua (8 x 300 MW).
            (Battery, 113.9542, 23.7653),
        ],
    ),
)
