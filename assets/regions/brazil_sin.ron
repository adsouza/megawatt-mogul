// Brazil: the main 60 Hz synchronous component of the Sistema Interligado
// Nacional (SIN) (spec section 28.3; research note
// docs/research/2026-10-18-world-power-grids-top-8.md, section "H - Brazil's
// main 60 Hz area"). The notes draw the whole mainland as a geographic proxy
// for the main grid's broad coverage, so the footprint is Natural Earth
// admin-0 BRA; it does not claim every isolated Amazon community.
//
// Grid-operation rulings, all from that section of the notes:
// - Roraima is in: its main system joined the SIN by the Manaus-Boa Vista
//   connection in September 2025 (TCU Acordao 1077/2026, paragraphs 37-38
//   and 62-63; ONS instruction IO-ON.N.5RR, revision 24, sections 4.2-4.3).
//   Venezuela, whose Santa Elena supply may not run in parallel, is out.
// - Itaipu's 60 Hz units belong to Brazil and its 50 Hz units do not, so
//   Paraguay is out; Argentina and Uruguay, linked only through converters,
//   are out too. Itaipu stands here as Brazilian hydro at Foz do Iguacu.
// - Santo Antonio's AC-connected units are in; Jirau, which normally runs
//   asynchronously, and the other converter-fed generator groups are not
//   modelled (EPE study EPE-DEE-RE-057-2024, cited by the notes).
// The footprint contains no disputed area that the notes leave open.
//
// Geography: tools/region_authoring/selections/brazil_sin.args holds the
// extractor arguments: Natural Earth v5.1.2 1:50m admin-0 BRA, dissolved
// (ruling 8 makes dissolve the default; it also merges the feature's parts
// that share vertices, so the loss falls from 0.582% to 0.561%). Regenerate
// with
//   tr '\n' '\0' < tools/region_authoring/selections/brazil_sin.args \
//       | xargs -0 python3 -I tools/region_authoring/natural_earth.py
// which reports 3 land and 0 exclude rings (the mainland, Marajo and
// Gurupa in the Amazon mouth; the selection has no exclusions, so the
// exclude count matches, ruling 9).
// Fernando de Noronha and the other oceanic islands lie east of the bounds.
// Nudge rings after the generated rings put the coastal metros, and the
// Angra nuclear plant, on land cells. Points are (lon, lat) in degrees.
//
// Grid: 74 to 34 W and 34 S to 5.5 N on 126 x 128 cells; the grid crosses
// the equator. At the middle latitude, 14.25 S, a cell is 34.21 km
// east-west by 34.31 km north-south (aspect 1.003, cell_km 34.264).
//
// Money is in BRL (reais) at local price levels from the Plan 7 research
// note (docs/research/2026-10-25-plan-7-regional-economics.md), converted to
// game values by its pacing method. Each entry's comment cites its rows and
// shows the arithmetic; the ratios use full precision.
(
    region_schema: 4,
    id: "brazil_sin",
    system_zone: 1,
    // Brasilia time (BRT, UTC-3) is the dispatcher's clock and covers the
    // Southeast, South, Northeast, Goias, Tocantins, Para and Amapa; Amazon
    // time (AMT, UTC-4) covers Amazonas, Rondonia, Roraima, Mato Grosso and
    // Mato Grosso do Sul; Acre time (ACT, UTC-5) covers Acre. Brazil has
    // observed no daylight saving since 2019 (spec section 28.4).
    time_zones: [
        (id: 1, name_key: "zone-brt", standard_offset_minutes: -180, dst_months: [false, false, false, false, false, false, false, false, false, false, false, false]),
        (id: 2, name_key: "zone-amt", standard_offset_minutes: -240, dst_months: [false, false, false, false, false, false, false, false, false, false, false, false]),
        (id: 3, name_key: "zone-act", standard_offset_minutes: -300, dst_months: [false, false, false, false, false, false, false, false, false, false, false, false]),
    ],
    // Southern meteorological seasons (spec section 28.6): summer from
    // December to February, winter from June to August.
    calendar: (seasons: [Summer, Summer, Autumn, Autumn, Autumn, Winter, Winter, Winter, Spring, Spring, Spring, Summer]),
    currency: BRL,
    atlas: (colour: "#1E8F59"),
    name_key: "region-brazil-sin",
    bounds: (west: -74.0, east: -34.0, south: -34.0, north: 5.5),
    grid: (width: 126, height: 128),
    // Generated rings (spec section 28.11.1): natural_earth.ron, written by
    // tools/region_authoring/selections/brazil_sin.args, whose header records the source data
    // and command.
    geography: ["natural_earth.ron"],
    land: [
        // Nudge rings (hand-authored, not generated). At 34 km cells the
        // half-cell simplification and the coastline itself leave these
        // coastal places' cell centres offshore; each box spans the place's
        // coordinate and its cell centre, 0.05 degrees wider on every side.
        // Santos.
        [
            (-46.379, -24.021), (-46.379, -23.884), (-46.172, -23.884), (-46.172, -24.021),
        ],
        // Rio de Janeiro.
        [
            (-43.256, -23.095), (-43.256, -22.861), (-42.998, -22.861), (-42.998, -23.095),
        ],
        // Vitória.
        [
            (-40.347, -20.361), (-40.347, -20.218), (-40.140, -20.218), (-40.140, -20.361),
        ],
        // Florianópolis.
        [
            (-48.603, -27.724), (-48.603, -27.543), (-48.394, -27.543), (-48.394, -27.724),
        ],
        // Salvador.
        [
            (-38.653, -13.033), (-38.653, -12.811), (-38.443, -12.811), (-38.443, -13.033),
        ],
        // Aracaju.
        [
            (-37.100, -11.060), (-37.100, -10.867), (-36.966, -10.867), (-36.966, -11.060),
        ],
        // Maceió.
        [
            (-35.796, -9.825), (-35.796, -9.616), (-35.685, -9.616), (-35.685, -9.825),
        ],
        // Recife.
        [
            (-34.931, -8.104), (-34.931, -7.874), (-34.744, -7.874), (-34.744, -8.104),
        ],
        // João Pessoa.
        [
            (-34.930, -7.170), (-34.930, -6.948), (-34.744, -6.948), (-34.744, -7.170),
        ],
        // Natal.
        [
            (-35.259, -5.845), (-35.259, -5.714), (-35.061, -5.714), (-35.061, -5.845),
        ],
        // Fortaleza.
        [
            (-38.653, -3.777), (-38.653, -3.554), (-38.478, -3.554), (-38.478, -3.777),
        ],
        // Belém.
        [
            (-48.554, -1.506), (-48.554, -1.393), (-48.394, -1.393), (-48.394, -1.506),
        ],
        // Macapá.
        [
            (-51.115, -0.017), (-51.115, 0.150), (-50.934, 0.150), (-50.934, -0.017),
        ],
        // Angra nuclear plant, at Itaorna on the Ilha Grande bay.
        [
            (-44.508, -23.095), (-44.508, -22.958), (-44.267, -22.958), (-44.267, -23.095),
        ],
    ],
    exclude: [],
    // Relief: the Guiana Highlands on the Roraima and Amazonas border, the
    // Brazilian Highlands across the Centre-West and the Southeast, the
    // Serra do Mar and Serra da Mantiqueira behind Sao Paulo and Rio, the
    // Espinhaco range in Minas Gerais and the southern plateau of Parana and
    // Santa Catarina; the Amazon basin and the Pantanal are low. Named
    // ranges only; heights are an authoring judgment (no elevation dataset
    // was used).
    height: (
        base: 0.2,
        blobs: [
            // The Guiana Highlands.
            (lon: -63.0, lat: 3.5, radius_deg: 1.5, value: 0.3),
            // The Brazilian Highlands and the Espinhaco range.
            (lon: -47.5, lat: -15.5, radius_deg: 3.0, value: 0.2),
            (lon: -43.8, lat: -18.5, radius_deg: 1.5, value: 0.3),
            // The Serra do Mar and the Serra da Mantiqueira.
            (lon: -45.5, lat: -22.6, radius_deg: 1.0, value: 0.35),
            (lon: -48.0, lat: -24.5, radius_deg: 0.8, value: 0.25),
            // The southern plateau.
            (lon: -50.5, lat: -26.5, radius_deg: 1.5, value: 0.25),
            // The Amazon basin and the Pantanal.
            (lon: -60.0, lat: -3.5, radius_deg: 5.0, value: -0.15),
            (lon: -57.0, lat: -18.0, radius_deg: 1.5, value: -0.15),
        ],
    ),
    // Sunshine as site quality without latitude (spec section 28.5), from the
    // Atlas Brasileiro de Energia Solar (INPE, 2nd edition, 2017) as
    // summarised by Ferreira and Paiva, "Avaliacao do Potencial de Geracao de
    // Energia Fotovoltaica ...", Anuario do Instituto de Geociencias UFRJ,
    // vol. 43(3), 2020, pp. 374-375, doi 10.11137/2020_3_374_385: the
    // Northeast averages about 5.5 kWh/m2 a day, the Centre-West and the
    // Southeast 5.0, the North and the South 4.5; the maximum, 6.5, is in
    // semi-arid northern Bahia and the minimum, 4.25, in northeastern Santa
    // Catarina. The base, 0.55, is the authoring scale for the Southeast and
    // Centre-West (5.0, as in the Southern China file); the other regions
    // scale by their ratio to 5.0: Northeast 0.605, North and South 0.495,
    // northern Bahia 0.715 and northeastern Santa Catarina 0.4675 at the
    // blob centres. The South's figure includes some latitude effect that
    // the computed sun already applies (authoring judgment: no
    // latitude-free figure was sourced).
    irradiance: (
        base: 0.55,
        blobs: [
            // The Northeast and its semi-arid core in northern Bahia.
            (lon: -39.5, lat: -7.5, radius_deg: 3.0, value: 0.055),
            (lon: -41.0, lat: -10.0, radius_deg: 1.2, value: 0.12),
            // The cloudy Amazon North.
            (lon: -60.0, lat: -4.0, radius_deg: 5.0, value: -0.055),
            // The South and northeastern Santa Catarina.
            (lon: -52.5, lat: -29.5, radius_deg: 2.5, value: -0.055),
            (lon: -49.0, lat: -26.6, radius_deg: 0.7, value: -0.06),
        ],
    ),
    // Water for thermal plants: the Atlantic coast from Amapa to Chui and
    // the big rivers inland (the Amazon, the Madeira, the Tocantins, the Sao
    // Francisco, the Parana and its Tiete, Grande and Paranaiba tributaries,
    // and the Jacui at Porto Alegre). Blobs sit on the Natural Earth
    // coastline and the named rivers (authoring judgment; no
    // water-availability dataset was used). The Ilha Grande bay blob covers
    // the Angra plant.
    cooling_water: (
        base: 0.08,
        blobs: [
            // The Atlantic coast, north to south.
            (lon: -50.9, lat: 1.5, radius_deg: 0.6, value: 0.7),
            (lon: -48.5, lat: -1.2, radius_deg: 0.6, value: 0.7),
            (lon: -47.2, lat: -0.8, radius_deg: 0.6, value: 0.7),
            (lon: -44.3, lat: -2.6, radius_deg: 0.6, value: 0.7),
            (lon: -41.8, lat: -2.9, radius_deg: 0.6, value: 0.7),
            (lon: -39.9, lat: -2.9, radius_deg: 0.6, value: 0.7),
            (lon: -38.7, lat: -3.6, radius_deg: 0.6, value: 0.7),
            (lon: -37.4, lat: -4.7, radius_deg: 0.6, value: 0.7),
            (lon: -35.6, lat: -5.2, radius_deg: 0.6, value: 0.7),
            (lon: -35.1, lat: -6.5, radius_deg: 0.6, value: 0.7),
            (lon: -35.0, lat: -8.2, radius_deg: 0.6, value: 0.7),
            (lon: -35.7, lat: -9.7, radius_deg: 0.6, value: 0.7),
            (lon: -37.0, lat: -10.9, radius_deg: 0.6, value: 0.7),
            (lon: -38.5, lat: -12.9, radius_deg: 0.6, value: 0.7),
            (lon: -39.0, lat: -14.8, radius_deg: 0.6, value: 0.7),
            (lon: -39.1, lat: -16.4, radius_deg: 0.6, value: 0.7),
            (lon: -39.5, lat: -18.3, radius_deg: 0.6, value: 0.7),
            (lon: -40.3, lat: -20.3, radius_deg: 0.6, value: 0.7),
            (lon: -41.3, lat: -21.9, radius_deg: 0.6, value: 0.7),
            (lon: -43.2, lat: -22.9, radius_deg: 0.6, value: 0.7),
            (lon: -44.45, lat: -23.0, radius_deg: 0.6, value: 0.7),
            (lon: -46.3, lat: -23.95, radius_deg: 0.6, value: 0.7),
            (lon: -47.6, lat: -24.7, radius_deg: 0.6, value: 0.7),
            (lon: -48.5, lat: -25.6, radius_deg: 0.6, value: 0.7),
            (lon: -48.65, lat: -26.9, radius_deg: 0.6, value: 0.7),
            (lon: -48.7, lat: -27.8, radius_deg: 0.6, value: 0.7),
            (lon: -49.2, lat: -28.6, radius_deg: 0.6, value: 0.7),
            (lon: -50.1, lat: -29.8, radius_deg: 0.6, value: 0.7),
            (lon: -51.2, lat: -30.9, radius_deg: 0.6, value: 0.7),
            (lon: -52.2, lat: -32.0, radius_deg: 0.6, value: 0.7),
            (lon: -53.0, lat: -33.2, radius_deg: 0.6, value: 0.7),
            // The Amazon at Manaus, Obidos and Santarem, and the Madeira at
            // Porto Velho.
            (lon: -60.0, lat: -3.1, radius_deg: 0.5, value: 0.6),
            (lon: -55.5, lat: -1.9, radius_deg: 0.5, value: 0.6),
            (lon: -54.7, lat: -2.4, radius_deg: 0.5, value: 0.6),
            (lon: -63.9, lat: -8.8, radius_deg: 0.5, value: 0.6),
            // The Tocantins at Tucurui and Estreito.
            (lon: -49.65, lat: -3.8, radius_deg: 0.5, value: 0.6),
            (lon: -47.45, lat: -6.6, radius_deg: 0.5, value: 0.6),
            // The Sao Francisco at Tres Marias, Petrolina and Paulo Afonso.
            (lon: -45.2, lat: -18.2, radius_deg: 0.5, value: 0.6),
            (lon: -40.5, lat: -9.4, radius_deg: 0.5, value: 0.6),
            (lon: -38.2, lat: -9.4, radius_deg: 0.5, value: 0.6),
            // The Parana and its Tiete, Grande and Paranaiba tributaries.
            (lon: -54.6, lat: -25.4, radius_deg: 0.5, value: 0.6),
            (lon: -53.0, lat: -22.5, radius_deg: 0.5, value: 0.6),
            (lon: -51.6, lat: -20.8, radius_deg: 0.5, value: 0.6),
            (lon: -48.5, lat: -22.5, radius_deg: 0.5, value: 0.6),
            (lon: -49.2, lat: -20.3, radius_deg: 0.5, value: 0.6),
            (lon: -46.3, lat: -20.7, radius_deg: 0.5, value: 0.6),
            (lon: -49.1, lat: -18.4, radius_deg: 0.5, value: 0.6),
            // The Jacui and the Guaiba at Porto Alegre.
            (lon: -51.6, lat: -29.9, radius_deg: 0.5, value: 0.6),
        ],
    ),
    // Hydro sites at real dams (Wikidata P625 coordinates of each plant's
    // English Wikipedia article item, read 2026-10-25): Itaipu (Q244169;
    // its 60 Hz units), Belo Monte (Q816119), Tucurui (Q1475210), Ilha
    // Solteira (Q574608), Tres Irmaos (Q1784127), Agua Vermelha (Q249680),
    // Marimbondo (Q10388425), Sao Simao (Q2378013), Itumbiara (Q1467568),
    // Furnas (Q1475039), Serra da Mesa (Q1460686), Estreito (Q50758251), Xingo
    // (Q501132), Paulo Afonso (Q1142374), Sobradinho (Q45628), Santo Antonio
    // (Q1510066; its AC-connected units), Teles Pires (Q7696787), Bento
    // Munhoz (Q1440269), Ita (Q1142762) and Henry Borden (Q20059654). Values
    // rank them by installed capacity (authoring judgment).
    hydro_potential: (
        base: 0.0,
        blobs: [
            (lon: -54.59, lat: -25.4078, radius_deg: 0.4, value: 0.95),
            (lon: -51.7758, lat: -3.1278, radius_deg: 0.4, value: 0.95),
            (lon: -49.6491, lat: -3.8325, radius_deg: 0.4, value: 0.95),
            (lon: -51.35, lat: -20.3833, radius_deg: 0.3, value: 0.9),
            (lon: -51.3, lat: -20.6694, radius_deg: 0.25, value: 0.7),
            (lon: -50.3431, lat: -19.8583, radius_deg: 0.3, value: 0.8),
            (lon: -49.1978, lat: -20.3031, radius_deg: 0.3, value: 0.8),
            (lon: -50.4997, lat: -19.0192, radius_deg: 0.3, value: 0.85),
            (lon: -49.0983, lat: -18.4076, radius_deg: 0.3, value: 0.85),
            (lon: -46.3181, lat: -20.6697, radius_deg: 0.3, value: 0.8),
            (lon: -48.3058, lat: -13.829, radius_deg: 0.3, value: 0.75),
            (lon: -47.4575, lat: -6.5864, radius_deg: 0.3, value: 0.75),
            (lon: -37.7911, lat: -9.6209, radius_deg: 0.3, value: 0.9),
            (lon: -38.2022, lat: -9.3969, radius_deg: 0.3, value: 0.9),
            (lon: -40.8251, lat: -9.4253, radius_deg: 0.3, value: 0.75),
            (lon: -63.9508, lat: -8.8017, radius_deg: 0.35, value: 0.85),
            (lon: -56.776, lat: -9.3497, radius_deg: 0.3, value: 0.8),
            (lon: -51.6691, lat: -26.0067, radius_deg: 0.3, value: 0.8),
            (lon: -52.3833, lat: -27.2772, radius_deg: 0.3, value: 0.8),
            (lon: -46.4541, lat: -23.8705, radius_deg: 0.25, value: 0.7),
        ],
    ),
    // Wind sites, ranked by each state's 2022 wind generation (ABEEolica,
    // "Annual Wind Energy Report 2022", "Generation by State - 2022", p. 6,
    // ANEEL/CCEE data: Bahia 24.17 TWh, Rio Grande do Norte 23.20, Piaui
    // 10.29, Ceara 7.06 and Rio Grande do Sul 5.37). Blob placement on each
    // state's wind belt (the Bahia and Piaui sertao, the Rio Grande do Norte
    // and Ceara coast, the Rio Grande do Sul coast) is an authoring judgment.
    wind_potential: (
        base: 0.2,
        blobs: [
            (lon: -41.5, lat: -11.5, radius_deg: 1.5, value: 0.45),
            (lon: -36.3, lat: -5.4, radius_deg: 1.0, value: 0.45),
            (lon: -41.5, lat: -8.0, radius_deg: 1.0, value: 0.35),
            (lon: -39.5, lat: -3.3, radius_deg: 0.8, value: 0.3),
            (lon: -50.8, lat: -30.8, radius_deg: 1.0, value: 0.25),
        ],
    ),
    // The northeastern "safra dos ventos": each month's factor is the 2022
    // SIN wind capacity factor (ABEEolica, "Annual Wind Energy Report 2022",
    // "Capacity factor - 2022", p. 7, ANEEL/CCEE data: 30, 32, 35, 34, 38,
    // 39, 51, 56, 57, 56, 36 and 36%; year 41.5%) over its annual mean,
    // times the Eastern Interconnection's annual mean factor, 0.567
    // (authoring scale, as in the Southern China file). The Northeast is
    // 90.3% of Brazil's wind capacity (same report, p. 5), so the national
    // curve is the northeastern one: it peaks in September.
    wind: (monthly: [0.41, 0.44, 0.48, 0.46, 0.52, 0.53, 0.70, 0.77, 0.78, 0.77, 0.49, 0.49], persistence: 0.995, innovation_sd: 0.015, initial_sd: 0.15, band: 0.25),
    // Unit sizes and operating parameters follow the North American catalog
    // (spec section 3.2): the EPE rows give costs per kW without a reference
    // unit size. Money and build months come from the Plan 7 research note
    // by its pacing method (ratios from its pacing table, at full precision;
    // game values rounded to 3 significant figures per kW, per kW-year or
    // per MWh, then multiplied by capacity; monthly fixed O&M is the
    // per-kW-year value x kW / 12, to the nearest real). The EPE rows are
    // December 2024 BRL (EPE/MME, PDE 2035 Caderno de Parametros de Custos);
    // build months use its average disbursement periods through month_ratio,
    // clamped to the pacing ceilings (ruling 1). Fuel is EPE's variable unit
    // cost (CVU, fuel plus variable O&M) through the NA marginal ratio, so
    // ruling 19's tariff proxy is not needed. Start-ups follow ruling 2 (NA
    // start-up x local marginal / NA marginal, at full precision).
    catalog: [
        // Wind [P7-BR-001] [P7-US-001]: the median of EPE's four levels,
        // 5,850 BRL/kW x (1,000 / 1,489 = 0.67159) = 3,928.8, so 3,930 BRL/kW
        // x 300,000 kW = 1,179,000,000. Fixed O&M [P7-BR-003] [P7-US-003]: 110
        // BRL/kW-yr x (20.0 / 33.06 = 0.60496) = 66.55, so 66.5 x 300,000 /
        // 12 = 1,662,500. Build [P7-BR-002] [P7-US-002]: 24 months x (3 / 9)
        // = 8 months (ruling 1, sourced local duration; wind has no ceiling).
        (kind: Wind, capacity_mw: 300.0, min_stable: 0.0, ramp_mw_per_min: 0.0, startup_hours: 0.0, startup_cost: 0, marginal_cost_per_mwh: 0.0, fixed_om_per_month: 1662500, capital_cost: 1179000000, build_months: 8, capacity_credit: 0.2, book_life_months: 300, siting: Anywhere),
        // Nuclear (Angra 1 and 2 are the fleet). Capital [P7-BR-014]
        // [P7-US-004]: 35,000 BRL/kW x (2,181.82 / 7,861 = 0.27755) = 9,714.2,
        // so 9,710 BRL/kW x 1,100,000 kW = 10,681,000,000. Fixed O&M
        // [P7-BR-016] [P7-US-006]: 760 x (120.0 / 156.20 = 0.76825) = 583.9,
        // so 584 x 1,100,000 / 12 = 53,533,333. Marginal [P7-BR-017]
        // [P7-US-025] [P7-US-029]: CVU 60 BRL/MWh x (10 / 9.16 = 1.09170) =
        // 65.50, so 65.5. Start-up (ruling 2, authoring judgment: no sourced
        // local start-up): 1,000,000 x 65.502 / 10 = 6,550,218, so 6,550,000.
        // Build [P7-BR-015] [P7-US-005]: 60 months x (18 / 52) = 20.8, so 21
        // months (ruling 1, sourced; ceiling 24).
        (
            kind: Nuclear,
            capacity_mw: 1100.0,
            min_stable: 0.7,
            ramp_mw_per_min: 5.0,
            startup_hours: 48.0,
            startup_cost: 6550000,
            marginal_cost_per_mwh: 65.5,
            fixed_om_per_month: 53533333,
            capital_cost: 10681000000,
            build_months: 21,
            capacity_credit: 0.95,
            book_life_months: 480,
            siting: CoolingWater(0.5),
        ),
        // Coal (domestic coal, as at Candiota and Jorge Lacerda). Capital
        // [P7-BR-010] [P7-US-007]: 15,000 BRL/kW x (1,166.67 / 4,103 =
        // 0.28434) = 4,265.2, so 4,270 BRL/kW x 600,000 kW = 2,562,000,000.
        // Fixed O&M [P7-BR-012] [P7-US-009]: 300 x (40.0 / 61.60 = 0.64935) =
        // 194.8, so 195 x 600,000 / 12 = 9,750,000. Marginal [P7-BR-013]
        // [P7-US-026] [P7-US-030]: CVU 180 x (30 / 27.30 = 1.09890) = 197.8,
        // so 198. Start-up (ruling 2, authoring judgment: no sourced local
