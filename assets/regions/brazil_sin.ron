    demand_noise: (forecast_error: 0.03, error_persistence: 0.995),
    // Regional cloud from Sao Paulo's sunshine (INMET normals at Mirante de
    // Santana, as tabulated by English Wikipedia "Sao Paulo", "Climate data
    // for Sao Paulo (Mirante de Santana)", read 2026-10-25: 139.1, 153.5,
    // 161.6, 169.3, 167.6, 160.0, 169.0, 173.1, 144.5, 157.9, 152.8 and 145.1
    // hours, 1981-2010 sunshine), as a share of the possible hours on the
    // 15th at 23.55 S (FAO-56 equations 24, 25 and 34) and through the
    // Angstrom-Prescott relation with the FAO-56 defaults (Allen et al., FAO
    // Irrigation and Drainage Paper 56, 1998, equation 35: a = 0.25, b =
    // 0.50), normalised to clear sky (0.75): (0.25 + 0.5 x share) / 0.75. The
    // wet summer is the cloudiest, the dry winter the clearest.
    solar: (
        clearness_mean: [0.56, 0.62, 0.62, 0.66, 0.67, 0.67, 0.67, 0.67, 0.60, 0.60, 0.59, 0.57],
        clearness_sd: 0.13,
    ),
    // Usable river flow (spec section 28.6: high from December to April). The
    // shape follows Sao Paulo's rain (the same INMET normals: 292.1, 257.7,
    // 229.1, 87.0, 66.3, 59.7, 48.4, 32.3, 83.3, 127.2, 143.9 and 231.3 mm),
    // which falls from December to March and is driest in August, with the
    // river a month behind the rain as the basins drain, so flow is lowest in
    // September. The Southeast/Centre-West subsystem's natural inflow energy
    // in 1931-2012 averaged 32,994 MWmed, with a median of 27,354 and a
    // minimum of 9,115 (PUC-Rio thesis, Certificacao Digital No. 1012124/CA,
    // chapter 5, "Aplicacao a Energia Natural Afluente", Table 5.1, p. 63,
    // ONS data), so the driest month's factor, 0.48, stays above the record
    // low of 0.28 of the mean. The monthly factors are an authoring judgment
    // on that shape (no monthly long-term-average table was reached).
    hydro: (monthly_flow: [1.55, 1.7, 1.6, 1.25, 0.9, 0.75, 0.62, 0.52, 0.48, 0.55, 0.8, 1.15]),
    // North American protection and performance values at 60 Hz (Global
    // Constraints).
    frequency: (
        nominal_hz: 60.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    // Currency-neutral ratios as in North America; only the two tariffs are
    // local.
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        // Tariffs [P7-BR-029] [P7-US-034]: 748.41 BRL/MWh x (95 / 135.6 =
        // 0.70059) = 524.3, so 524 to start, and x (100 / 135.6 = 0.73746) =
        // 551.9, so a reference of 552 (the same 0.95 relation as shipped).
        // Basis: P7-BR-029 is the average billed tariff across all consumer
        // classes, while P7-US-034 is an all-sector retail average
        // (authoring judgment: basis differs from the US all-sector
        // reference; not re-based).
        starting_tariff_per_mwh: 524.0,
        reference_tariff_per_mwh: 552.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
        reliability_target: 0.999,
        return_per_reliability: 2.0,
        return_per_cost_improvement: 0.05,
        reserve_margin: 0.2,
        strike_threshold: 0.005,
        strikes_to_revoke: 3,
        clean_months_to_expire: 3,
        frequency_band_hz: 0.2,
        frequency_violation_share: 0.05,
    ),
    satisfaction: (
        starting: 70.0,
        reliability_floor: 0.95,
        price_sensitivity: 2.0,
        smoothing: 0.2,
    ),
    // Lines. Cost [P7-BR-028] [P7-US-033]: EPE's 2026-2035 line investment,
    // 78.0 billion BRL for 28,781 km, is 2,710,121 BRL/km (an average over
    // 230-800 kV, HVDC poles included; the note has no per-voltage figure).
    // Paced by the NA line ratio (466,832 / 2,796,170 = 0.16695) it is
    // 452,466, so 452,000 BRL/km x cell_km 34.264 = 15,487,296 BRL per cell.
    // A sourced row wins, so ruling 20's coal relativity (1,706,673 BRL/km)
    // is not used. Build speed (rulings 5 and 21, authoring judgment: cell
    // width is the note's cell_km): 201.07 km per month / 34.264 km = 5.87,
    // so 6 cells per month.
    lines: (cost_per_cell: 15487296, cells_per_month: 6, book_life_months: 600),
    // The Sao Paulo core: Sao Paulo, Campinas and Santos.
    start: (
        year: 2027,
        month: 1,
        // Cash (tuned freely; scale from [P7-BR-010]): the Eastern
        // Interconnection's 5,000,000,000 x the local coal capital relativity
        // (4,265.17 / 1,166.67 = 3.65586) = 18,279,307,824, so 18,300,000,000
        // BRL.
        cash: 18300000000,
        // Sao Paulo anchors the starting service territory.
        home_city: 1,
        connected_cities: [1, 2, 3],
        // Real plants at their published coordinates (Wikidata P625 of each
        // plant's English Wikipedia article item, read 2026-10-25, unless
        // noted), following the Southeast's hydro-led mix. Each plant's cell
        // is land.
        fleet: [
            // Nuclear: Angra (Almirante Alvaro Alberto), Angra dos Reis (Q740586;
            // Angra 1 and 2, 1,990 MW). A nudge ring puts its shore cell on land.
            (Nuclear, -44.45833, -23.00833),
            // Hydro: Itaipu's 60 Hz units at Foz do Iguacu (Q244169), sent to
            // Sao Paulo over Furnas' 765 kV AC lines; Ilha Solteira on the
            // Parana (Q574608, 3,444 MW); Furnas on the Grande (Q1475039,
            // 1,216 MW); and Henry Borden at Cubatao, below the Serra do Mar
            // (Q20059654, 889 MW).
            (Hydro, -54.59, -25.407778),
            (Hydro, -51.35, -20.383333),
            (Hydro, -46.318056, -20.669722),
            (Hydro, -46.454136, -23.870489),
            // Combined cycle: TermoRio (Leonel Brizola), Duque de Caxias, 1,044
            // MW (English Wikipedia, "List of power stations in Brazil", gas
            // turbines table, 22 42 52 S, 43 15 15 W); and Norte Fluminense,
            // Macae, 827 MW combined cycle (Global Energy Monitor wiki, "Norte
            // Fluminense power station", Table 1, -22.3055, -41.8814).
            (Ccgt, -43.2542, -22.7144),
            (Ccgt, -41.8814, -22.3055),
        ],
    ),
)
