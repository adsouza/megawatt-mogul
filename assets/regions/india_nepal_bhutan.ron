    // Lines. Cost (ruling 20, authoring judgment: derived from [P7-IN-001]
    // by NA kind relativity; P7-IN-010 is per MW-km of transfer capacity, so
    // it gives no per-km figure): local game coal 27,599.22 INR/kW x the NA
    // line cost per km over NA coal per kW (466,832 / 1,166.67 = 400.14, the
    // NA line figure from the [P7-US-033] pacing table) = 11,043,598, so
    // 11,000,000 INR/km x cell_km 25.678 = 282,456,574 INR per cell. Build
    // speed (rulings 5 and 21, authoring judgment: cell width is the note's
    // cell_km): 201.07 km per month / 25.678 km = 7.83, so 8 cells per month.
    lines: (cost_per_cell: 282456574, cells_per_month: 8, book_life_months: 600),
    // The National Capital Region core: Delhi, Gurgaon and Noida.
    start: (
        year: 2027,
        month: 1,
        // Cash (tuned freely; scale from [P7-IN-001]): the Eastern
        // Interconnection's 5,000,000,000 x the local coal capital relativity
        // (27,599.22 / 1,166.67 = 23.65647) = 118,282,354,375, so
        // 118,000,000,000 INR.
        cash: 118000000000,
        // Delhi anchors the starting service territory.
        home_city: 1,
        connected_cities: [1, 2, 3],
        // Real plants at their published coordinates (each plant's English
        // Wikipedia infobox, or its Wikidata P625 where the article has none,
        // read 2026-10-25), following northern India's coal-led mix with
        // Himalayan hydro, gas and nuclear. Each plant's cell is land.
        fleet: [
            // Nuclear: Narora Atomic Power Station on the Ganga (Q1312991; 2 x
            // 220 MW PHWRs).
            (Nuclear, 78.40944444, 28.15805556),
            // Coal: NTPC Dadri, Gautam Buddh Nagar (Q6955488; 1,840 MW coal),
            // and the Indira Gandhi Super Thermal Power Project at Jhajjar
            // (Q16934765, Wikidata; 3 x 500 MW).
            (Coal, 77.60944444, 28.59833333),
            (Coal, 76.3753, 28.4786),
            // Combined cycle: Pragati-III at Bawana, Delhi (English Wikipedia,
            // "Pragati-III Combined Cycle Power Plant", 28.79472 N, 77.07 E;
            // 2 x 750 MW).
            (Ccgt, 77.07, 28.79472),
            // Hydro: Tehri on the Bhagirathi (Q69091; 1,000 MW) and Bhakra on
            // the Sutlej (Q83436; 1,325 MW), carried to the plains.
            (Hydro, 78.48055556, 30.37777778),
