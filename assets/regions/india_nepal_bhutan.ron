            month_shapes: ["winter", "winter", "summer", "summer", "summer", "summer", "summer", "summer", "summer", "summer", "winter", "winter"],
            monthly: [1.10, 1.06, 1.00, 0.95, 0.96, 0.98, 0.98, 0.98, 0.96, 0.96, 1.00, 1.08],
        ),
    ],
    demand_noise: (forecast_error: 0.03, error_persistence: 0.995),
    // Regional cloud from New Delhi's sunshine (IMD normals at Safdarjung, as
    // tabulated by English Wikipedia "Delhi", "Climate data for New Delhi
    // (Safdarjung)", read 2026-10-25: 220.1, 223.2, 248.0, 276.0, 285.2,
    // 219.0, 179.8, 176.7, 219.0, 260.4, 246.0 and 220.1 hours, sun
    // 1971-2000), as a share of the possible hours on the 15th at 28.61 N
    // (FAO-56 equations 24, 25 and 34) and through the Angstrom-Prescott
    // relation with the FAO-56 defaults (Allen et al., FAO Irrigation and
    // Drainage Paper 56, 1998, equation 35: a = 0.25, b = 0.50), normalised to
    // clear sky (0.75): (0.25 + 0.5 x share) / 0.75. The monsoon months are
    // the cloudiest (June to September mean 0.67 against 0.76 for the year).
    solar: (
        clearness_mean: [0.79, 0.82, 0.79, 0.82, 0.79, 0.69, 0.62, 0.63, 0.73, 0.83, 0.85, 0.80],
        clearness_sd: 0.13,
    ),
    // Usable river flow (spec section 28.6: a monsoon high). The shape
    // follows New Delhi's rain (the same IMD normals: 19.1, 21.3, 17.4, 16.3,
    // 30.7, 74.1, 209.7, 233.1, 123.5, 15.1, 6.0 and 8.1 mm), which falls
    // mostly from July to September, with Himalayan snowmelt raising the
    // rivers from May and the reservoirs draining into October; flow is
    // lowest from December to February. The monthly factors are an authoring
    // judgment on that shape (no monthly long-term inflow or hydro generation
    // table was reached: the CEA report links returned 404).
    hydro: (monthly_flow: [0.5, 0.5, 0.55, 0.65, 0.85, 1.2, 1.65, 1.8, 1.55, 1.0, 0.65, 0.55]),
    // North American protection and performance values at 50 Hz (Global
    // Constraints).
    frequency: (
        nominal_hz: 50.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    // Currency-neutral ratios as in North America; only the two tariffs are
    // local.
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        // Tariffs [P7-IN-011] [P7-US-034]: the state distribution utilities'
        // average revenue realised, 7,030 INR/MWh x (95 / 135.6 = 0.70059) =
        // 4,925.1, so 4,930 to start, and x (100 / 135.6 = 0.73746) = 5,184.4,
        // so a reference of 5,180 (the same 0.95 relation as shipped).
        // Basis: P7-IN-011 is the average revenue realised across all
        // consumers of state distribution utilities, while P7-US-034 is an
        // all-sector retail average (authoring judgment: basis differs from
        // the US all-sector reference; not re-based). The fuel proxy (ruling
        // 19) scales by this same reference, so it inherits that basis.
        starting_tariff_per_mwh: 4930.0,
        reference_tariff_per_mwh: 5180.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
        reliability_target: 0.999,
        return_per_reliability: 2.0,
        return_per_cost_improvement: 0.05,
        reserve_margin: 0.2,
        strike_threshold: 0.005,
        strikes_to_revoke: 3,
        clean_months_to_expire: 3,
        frequency_band_hz: 0.2,
        frequency_violation_share: 0.05,
    ),
    satisfaction: (
        starting: 70.0,
        reliability_floor: 0.95,
        price_sensitivity: 2.0,
        smoothing: 0.2,
    ),
    // Lines. Cost (ruling 20, authoring judgment: derived from [P7-IN-001]
    // by NA kind relativity; P7-IN-010 is per MW-km of transfer capacity, so
    // it gives no per-km figure): local game coal 27,599.22 INR/kW x the NA
    // line cost per km over NA coal per kW (466,832 / 1,166.67 = 400.14, the
    // NA line figure from the [P7-US-033] pacing table) = 11,043,598, so
    // 11,000,000 INR/km x cell_km 25.678 = 282,456,574 INR per cell. Build
    // speed (rulings 5 and 21, authoring judgment: cell width is the note's
    // cell_km): 201.07 km per month / 25.678 km = 7.83, so 8 cells per month.
    lines: (cost_per_cell: 282456574, cells_per_month: 8, book_life_months: 600),
    // The National Capital Region core: Delhi, Gurgaon and Noida.
    start: (
        year: 2027,
        month: 1,
        // Cash (tuned freely; scale from [P7-IN-001]): the Eastern
        // Interconnection's 5,000,000,000 x the local coal capital relativity
        // (27,599.22 / 1,166.67 = 23.65647) = 118,282,354,375, so
        // 118,000,000,000 INR.
        cash: 118000000000,
        // Delhi anchors the starting service territory.
        home_city: 1,
        connected_cities: [1, 2, 3],
        // Real plants at their published coordinates (each plant's English
        // Wikipedia infobox, or its Wikidata P625 where the article has none,
        // read 2026-10-25), following northern India's coal-led mix with
        // Himalayan hydro, gas and nuclear. Each plant's cell is land.
        fleet: [
            // Nuclear: Narora Atomic Power Station on the Ganga (Q1312991; 2 x
            // 220 MW PHWRs).
            (Nuclear, 78.40944444, 28.15805556),
            // Coal: NTPC Dadri, Gautam Buddh Nagar (Q6955488; 1,840 MW coal),
            // and the Indira Gandhi Super Thermal Power Project at Jhajjar
            // (Q16934765, Wikidata; 3 x 500 MW).
            (Coal, 77.60944444, 28.59833333),
            (Coal, 76.3753, 28.4786),
            // Combined cycle: Pragati-III at Bawana, Delhi (English Wikipedia,
            // "Pragati-III Combined Cycle Power Plant", 28.79472 N, 77.07 E;
            // 2 x 750 MW).
            (Ccgt, 77.07, 28.79472),
            // Hydro: Tehri on the Bhagirathi (Q69091; 1,000 MW) and Bhakra on
            // the Sutlej (Q83436; 1,325 MW), carried to the plains.
            (Hydro, 78.48055556, 30.37777778),
            (Hydro, 76.43333333, 31.41083333),
        ],
    ),
)
