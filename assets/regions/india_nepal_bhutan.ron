    demand_noise: (forecast_error: 0.03, error_persistence: 0.995),
    // Regional cloud from New Delhi's sunshine (IMD normals at Safdarjung, as
    // tabulated by English Wikipedia "Delhi", "Climate data for New Delhi
    // (Safdarjung)", read 2026-10-25: 220.1, 223.2, 248.0, 276.0, 285.2,
    // 219.0, 179.8, 176.7, 219.0, 260.4, 246.0 and 220.1 hours, sun
    // 1971-2000), as a share of the possible hours on the 15th at 28.61 N
    // (FAO-56 equations 24, 25 and 34) and through the Angstrom-Prescott
    // relation with the FAO-56 defaults (Allen et al., FAO Irrigation and
    // Drainage Paper 56, 1998, equation 35: a = 0.25, b = 0.50), normalised to
    // clear sky (0.75): (0.25 + 0.5 x share) / 0.75. The monsoon months are
    // the cloudiest (June to September mean 0.67 against 0.76 for the year).
    // A16: authored FAO Rs/Ra -> clear-sky fraction (/0.75); annual clouds counted once.
    solar: (calibration: AngstromPrescott,
        clearness_mean: [0.79, 0.82, 0.79, 0.82, 0.79, 0.69, 0.62, 0.63, 0.73, 0.83, 0.85, 0.80],
        clearness_sd: 0.13,
    ),
    // Usable river flow (spec section 28.6: a monsoon high). The shape
    // follows New Delhi's rain (the same IMD normals: 19.1, 21.3, 17.4, 16.3,
    // 30.7, 74.1, 209.7, 233.1, 123.5, 15.1, 6.0 and 8.1 mm), which falls
    // mostly from July to September, with Himalayan snowmelt raising the
    // rivers from May and the reservoirs draining into October; flow is
    // lowest from December to February. The monthly factors are an authoring
    // judgment on that shape (no monthly long-term inflow or hydro generation
    // table was reached: the CEA report links returned 404).
    hydro: (monthly_flow: [0.5, 0.5, 0.55, 0.65, 0.85, 1.2, 1.65, 1.8, 1.55, 1.0, 0.65, 0.55]),
    // North American protection and performance values at 50 Hz (Global
    // Constraints).
    frequency: (
        nominal_hz: 50.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    // Currency-neutral ratios as in North America; only the two tariffs are
    // local.
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        // Tariffs [P7-IN-011] [P7-US-034]: the state distribution utilities'
        // average revenue realised, 7,030 INR/MWh x (95 / 135.6 = 0.70059) =
        // 4,925.1, so 4,930 to start, and x (100 / 135.6 = 0.73746) = 5,184.4,
        // so a reference of 5,180 (the same 0.95 relation as shipped).
        // Basis: P7-IN-011 is the average revenue realised across all
        // consumers of state distribution utilities, while P7-US-034 is an
        // all-sector retail average (authoring judgment: basis differs from
        // the US all-sector reference; not re-based). The fuel proxy (ruling
        // 19) scales by this same reference, so it inherits that basis.
        starting_tariff_per_mwh: 4930.0,
        reference_tariff_per_mwh: 5180.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
