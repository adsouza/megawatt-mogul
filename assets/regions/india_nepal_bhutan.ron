                1.07, 1.07, 1.06, 1.05, 1.05, 1.09, 1.15, 1.15, 1.10, 1.02, 0.93, 0.85,
            ]),
            ],
            month_shapes: ["dry", "dry", "summer", "summer", "summer", "monsoon", "monsoon", "monsoon", "monsoon", "dry", "dry", "dry"],
            monthly: [0.96, 0.98, 1.04, 1.08, 1.09, 1.01, 0.96, 0.95, 0.98, 1.00, 0.97, 0.96],
        ),
        (id: 3,
            shapes: [
                ("winter", [
                0.72, 0.69, 0.67, 0.67, 0.69, 0.75, 0.88, 1.00, 1.06, 1.05, 1.02, 1.00,
                0.98, 0.97, 0.97, 0.99, 1.06, 1.20, 1.30, 1.26, 1.16, 1.03, 0.89, 0.78,
