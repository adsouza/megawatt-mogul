    ),
    // Lines. Cost [P7-EM-012] [P7-US-033]: ACER's median unit cost for a
    // 380-400 kV single-circuit overhead line, 397,000 EUR/km x (466,832 /
    // 2,796,170 = 0.16695) = 66,280.8, so 66,300 EUR/km x cell_km 33.414 =
    // 2,215,338 EUR per cell. Neither Spain nor Morocco has a sourced line
    // row, so no zone overrides it. Build speed (rulings 5 and 21, authoring
    // judgment: cell width is the note's cell_km): 201.07 km per month /
    // 33.414 km = 6.02, so 6 cells per month.
    lines: (cost_per_cell: 2215338, cells_per_month: 6, book_life_months: 600),
    // Seville, Malaga and Tangier, joined across the Strait of Gibraltar by
    // the pre-built Spain-Morocco interconnector (spec section 28.8).
    start: (
        // Tangier's starter line from Seville is the Spain-Morocco
        // interconnector.
        line_names: [(3, "line-spain-morocco")],
        year: 2027,
        month: 1,
        // Cash (tuned freely; scale from [P7-DE-002]): the Eastern
        // Interconnection's 5,000,000,000 x the local coal capital relativity
        // (568.6896 / 1,166.67 = 0.48745) = 2,437,241,043, so 2,440,000,000
        // EUR.
        cash: 2440000000,
        // Seville anchors the starting service territory.
        home_city: 1,
        connected_cities: [1, 2, 3],
        // Real plants at their published coordinates (Global Energy Monitor
        // wiki plant pages, "exact" coordinates, read 2026-10-25, unless
        // noted), following the region's gas-led Andalusian and Moroccan mix
        // with pumped hydro and solar. Each plant's cell is land (nudge rings
        // put the three coastal plants' offshore cell centres on land).
        fleet: [
            // Combined cycle: Arcos de la Frontera (36.6721, -5.8164; three
            // units, 1,585 MW), Campo de Gibraltar at San Roque (36.1834,
            // -5.3933; 780 MW), Palos de la Frontera at Huelva ("Palos power
            // station", 37.18448, -6.89279; three units) and Tahaddart near
            // Tangier ("Tahaddart power plant", 35.589177, -5.986626; 400 MW).
            (Ccgt, -5.8164, 36.6721),
            (Ccgt, -5.3933, 36.1834),
            (Ccgt, -6.89279, 37.18448),
            (Ccgt, -5.986626, 35.589177),
            // Hydro: the Tajo de la Encantada pumped-storage station in Malaga
            // province ("Tajo De La Encantada hydroelectric plant", 36.9084,
            // -4.763; 377 MW).
            (Hydro, -4.763, 36.9084),
            // Solar: Gemasolar at Fuentes de Andalucia (English Wikipedia,
            // "Gemasolar Thermosolar Plant", 37.558086 N, 5.329056 W; a 20 MW
            // solar tower).
            (Solar, -5.329056, 37.558086),
        ],
    ),
)
