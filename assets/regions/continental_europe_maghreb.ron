    demand_noise: (forecast_error: 0.03, error_persistence: 0.995),
    // Regional cloud from Seville's sunshine (WMO normals 1991-2020, as
    // tabulated by English Wikipedia, "List of cities in Europe by sunshine
    // duration", Spain, Seville, read 2026-10-25: 202.0, 212.2, 246.3, 270.2,
    // 324.9, 357.3, 388.1, 364.3, 278.4, 244.4, 205.3 and 185.9 hours), as a
    // share of the possible hours on the middle day of each month at 37.39 N
    // (FAO-56 equations 24, 25 and 34) and through the Angstrom-Prescott
    // relation with the FAO-56 defaults (Allen et al., FAO Irrigation and
    // Drainage Paper 56, 1998, equation 35: a = 0.25, b = 0.50), normalised to
    // clear sky (0.75): (0.25 + 0.5 x share) / 0.75. The starter territory's
    // summer is the clearest (July and August 0.92).
    solar: (
        clearness_mean: [0.78, 0.81, 0.79, 0.80, 0.83, 0.88, 0.92, 0.92, 0.84, 0.81, 0.79, 0.76],
        clearness_sd: 0.13,
    ),
    // Usable river flow: the Alpine and Pyrenean snowmelt raises the rivers
    // from April to June, the Iberian and Maghreb reservoirs fill with the
    // winter rain, and flow is lowest from August to October. The monthly
    // factors are an authoring judgment on that shape (no monthly European
    // inflow or hydro generation series was read).
    hydro: (monthly_flow: [1.0, 1.05, 1.15, 1.25, 1.3, 1.15, 0.9, 0.7, 0.65, 0.75, 0.95, 1.0]),
    // North American protection and performance values at 50 Hz (Global
    // Constraints).
    frequency: (
        nominal_hz: 50.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    // Currency-neutral ratios as in North America; only the two tariffs are
    // local.
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        // Tariffs [P7-EM-008] [P7-EM-009] [P7-US-034]: Eurostat's EU27 prices
        // excluding taxes and levies for 2025-S1, households 207.5 and
        // non-households 138.7 EUR/MWh, averaged (authoring judgment: the
