    // Relief: the Alps, the Pyrenees, the Atlas, the Carpathians, the Dinaric
    // and Balkan ranges, the Apennines, the Iberian Meseta and the Anatolian
    // plateau; the North European Plain and the Pontic lowlands are low. Named
    // ranges only; heights are an authoring judgment (no elevation dataset was
    // used).
    height: (
        base: 0.15,
        blobs: [
            // The Alps.
            (lon: 10.0, lat: 46.5, radius_deg: 1.8, value: 0.55),
            // The Pyrenees, the Massif Central and the Betic ranges.
            (lon: 0.5, lat: 42.6, radius_deg: 1.0, value: 0.4),
            (lon: 2.8, lat: 45.2, radius_deg: 1.0, value: 0.2),
            (lon: -3.3, lat: 37.1, radius_deg: 0.8, value: 0.3),
            // The Iberian Meseta.
            (lon: -4.0, lat: 40.0, radius_deg: 3.0, value: 0.15),
            // The High and Middle Atlas, and the Tell Atlas and Aures.
            (lon: -6.0, lat: 31.8, radius_deg: 1.5, value: 0.45),
            (lon: 5.5, lat: 35.5, radius_deg: 2.0, value: 0.2),
            // The Apennines, the Dinaric Alps and the Balkans, and the
            // Carpathians.
            (lon: 13.5, lat: 42.5, radius_deg: 1.5, value: 0.25),
            (lon: 19.0, lat: 43.0, radius_deg: 2.0, value: 0.3),
            (lon: 24.5, lat: 46.5, radius_deg: 2.5, value: 0.3),
            // The Anatolian plateau and eastern Anatolia.
            (lon: 34.0, lat: 39.0, radius_deg: 4.0, value: 0.3),
            (lon: 41.0, lat: 39.5, radius_deg: 2.0, value: 0.45),
            // The North European Plain and the Pontic lowlands.
            (lon: 15.0, lat: 53.0, radius_deg: 5.0, value: -0.1),
            (lon: 32.0, lat: 48.5, radius_deg: 4.0, value: -0.05),
        ],
    ),
    // Sunshine as site quality without latitude (spec section 28.5), from the
    // annual sunshine totals in English Wikipedia's "List of cities in Europe
    // by sunshine duration" and "List of cities by sunshine duration" (Africa
    // and Asia tables), read 2026-10-25. Each annual total is a share of the
    // possible hours at its latitude (FAO-56 equations 24, 25 and 34 on the
    // middle day of each month), turned into irradiance by the
    // Angstrom-Prescott relation (FAO-56 equation 35, a = 0.25, b = 0.50).
    // For example: Brussels 0.426, Paris 0.440, Berlin 0.436, Kyiv 0.473,
    // Vienna 0.484, Bucharest 0.491, Istanbul 0.503, Ankara 0.530, Rome
    // 0.532, Madrid 0.566, Athens 0.567, Algiers 0.575, Valletta 0.599,
    // Seville 0.624 and Ouarzazate 0.640. The base is north-western Europe's
    // level; the blobs are a least-squares fit of those 27 city values at
    // fixed, authored centres (rms error 0.018; placement is an authoring
