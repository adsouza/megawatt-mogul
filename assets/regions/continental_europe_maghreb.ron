    ),
    // Winter-high wind: each month's factor is the mean, over Hamburg (the
    // North Sea belt) and Seville, of the cube of the month's average wind
    // speed over the year's mean cube (Weather Spark, "Average Weather in
    // Hamburg, Germany Year Round" and "Average Weather in Sevilla, Spain Year
    // Round", table "Average Wind Speed", read 2026-10-25: Hamburg 12.8, 12.3,
    // 11.9, 10.3, 9.8, 9.8, 9.6, 9.6, 10.3, 10.9, 11.3 and 12.0 mph; Seville
    // 8.2, 8.4, 8.3, 8.3, 7.8, 7.4, 7.3, 7.0, 6.9, 7.6, 8.2 and 8.4 mph), times
    // the Eastern Interconnection's annual mean factor, 0.567 (authoring
    // scale, as in the other Plan 7 files).
    wind: (monthly: [0.77, 0.74, 0.69, 0.57, 0.48, 0.44, 0.42, 0.39, 0.43, 0.53, 0.63, 0.72], persistence: 0.995, innovation_sd: 0.015, initial_sd: 0.15, band: 0.25),
    // Unit sizes and operating parameters follow the North American catalog
    // (spec section 3.2): no row names a local unit size, so no start-up or
    // ramp is rescaled per MW (ruling 24). Money and build months come from the
    // Plan 7 research note by its pacing method (ratios from its pacing table,
    // at full precision; game values rounded to 3 significant figures per kW,
    // per kW-year or per MWh, then multiplied by capacity; monthly fixed O&M
    // is the per-kW-year value x kW / 12, to the nearest euro). No zone-0
    // build duration is sourced, so every kind keeps the North American game
    // months (ruling 1, authoring judgment: no sourced local duration).
    // Pacing judgments recorded for zone 0:
    // - P7-EM-010's hydro capital is in EUR2015 while the German rows are
    //   EUR2024; it is paced as stated, with no inflation adjustment (the
    //   note's method applies none).
    // - The Spain and Morocco wind zones (746 and 873 EUR/kW paced) both sit
    //   below zone 0's wind (1,070), because zone 0 is a technology-level
    //   midpoint for Germany (P7-DE-001) while the zones are single whole
    //   projects; the contrast of record is between the two projects.
    // - ERAA's gas and coal prices (P7-EM-013, P7-EM-014) are per net (lower)
    //   calorific GJ and are applied to the S&L higher-heating-value heat rates
    //   without conversion, which overstates fuel per MWh slightly.
    // Fuel is converted at 1 MMBtu = 1.055056 GJ: gas 7.60 x 1.055056 =
    // 8.018426 EUR/MMBtu [P7-EM-013] and hard coal 2.97 x 1.055056 = 3.133516
    // EUR/MMBtu [P7-EM-014].
    catalog: [
        // Wind [P7-DE-001] [P7-US-001]: the German 2024 range 1,300-1,900,
        // midpoint 1,600 EUR/kW x (1,000 / 1,489 = 0.67159) = 1,074.5, so
        // 1,070 EUR/kW x 300,000 kW = 321,000,000. Fixed O&M [P7-DE-008]
        // [P7-US-003]: 32 EUR/kW-yr x (20.0 / 33.06 = 0.60496) = 19.36, so 19.4
        // x 300,000 / 12 = 485,000. Build 3 months (ruling 1, authoring
        // judgment: no sourced local duration).
        (kind: Wind, capacity_mw: 300.0, min_stable: 0.0, ramp_mw_per_min: 0.0, startup_hours: 0.0, startup_cost: 0, marginal_cost_per_mwh: 0.0, fixed_om_per_month: 485000, capital_cost: 321000000, build_months: 3, capacity_credit: 0.2, book_life_months: 300, siting: Anywhere),
        // Nuclear. Capital [P7-DE-005] [P7-US-004]: the German range
        // 6,000-16,000, midpoint 11,000 EUR/kW x (2,181.82 / 7,861 = 0.27755) =
        // 3,053.0, so 3,050 EUR/kW x 1,100,000 kW = 3,355,000,000. Fixed O&M
        // [P7-DE-012] [P7-US-006]: 100 EUR/kW-yr x (120.0 / 156.20 = 0.76825) =
        // 76.82, so 76.8 x 1,100,000 / 12 = 7,040,000. Marginal (ruling 19,
        // authoring judgment: no sourced local fuel row; ERAA's nuclear fuel is
        // an EIA figure and P7-EM-004 is VOM only): 10 x the local reference
        // tariff over NA's, 127.6549 / 100 = 12.77, so 12.8 [P7-EM-008]
        // [P7-EM-009]. Start-up (ruling 2, authoring judgment: no sourced local
        // start-up): 1,000,000 x 12.76549 / 10 = 1,276,549, so 1,280,000. Build
        // 18 months (ruling 1, authoring judgment: no sourced local duration).
        (
            kind: Nuclear,
            capacity_mw: 1100.0,
            min_stable: 0.7,
            ramp_mw_per_min: 5.0,
            startup_hours: 48.0,
            startup_cost: 1280000,
            marginal_cost_per_mwh: 12.8,
            fixed_om_per_month: 7040000,
            capital_cost: 3355000000,
            build_months: 18,
            capacity_credit: 0.95,
            book_life_months: 480,
            siting: CoolingWater(0.5),
        ),
        // Coal (hard coal). Capital [P7-DE-002] [P7-US-007]: the German range
        // 1,700-2,300, midpoint 2,000 EUR/kW x (1,166.67 / 4,103 = 0.28434) =
        // 568.7, so 569 EUR/kW x 600,000 kW = 341,400,000. Fixed O&M [P7-EM-003]
        // [P7-US-009]: ERAA's 26-39, midpoint 32.5 EUR/kW-yr x (40.0 / 61.60 =
        // 0.64935) = 21.10, so 21.1 x 600,000 / 12 = 1,055,000. Marginal
        // [P7-EM-014] [P7-EM-007] [P7-US-026] [P7-US-030]: 3.133516 EUR/MMBtu x
        // 8.638 MMBtu/MWh = 27.067 fuel + VOM midpoint 3.45 = 30.517 EUR/MWh x
        // (30 / 27.30 = 1.09890) = 33.54, so 33.5. Start-up (ruling 2,
        // authoring judgment: no sourced local start-up): 150,000 x 33.53551 /
        // 30 = 167,678, so 168,000. Build 8 months (ruling 1, authoring
        // judgment: no sourced local duration).
        (
            kind: Coal,
            capacity_mw: 600.0,
            min_stable: 0.4,
            ramp_mw_per_min: 6.0,
            startup_hours: 8.0,
            startup_cost: 168000,
            marginal_cost_per_mwh: 33.5,
            fixed_om_per_month: 1055000,
            capital_cost: 341400000,
            build_months: 8,
            capacity_credit: 0.95,
            book_life_months: 480,
            siting: CoolingWater(0.5),
        ),
        // Combined cycle. Capital [P7-DE-003] [P7-US-010]: the German range
        // 900-1,300, midpoint 1,100 EUR/kW x (600 / 921 = 0.65147) = 716.6, so
        // 717 EUR/kW x 500,000 kW = 358,500,000. Fixed O&M [P7-EM-001]
        // [P7-US-012]: 34 EUR/kW-yr x (14.4 / 15.51 = 0.92843) = 31.57, so 31.6
        // x 500,000 / 12 = 1,316,667. Marginal [P7-EM-013] [P7-EM-005]
        // [P7-US-027] [P7-US-031]: 8.018426 EUR/MMBtu x 6.226 MMBtu/MWh = 49.923
        // fuel + VOM midpoint 2.5 = 52.423 EUR/MWh x (45 / 27.30 = 1.64835) =
        // 86.41, so 86.4. Start-up (ruling 2, authoring judgment: no sourced
        // local start-up): 40,000 x 86.41107 / 45 = 76,810, so 76,800. Build 4
        // months (ruling 1, authoring judgment: no sourced local duration).
        (
            kind: Ccgt,
            capacity_mw: 500.0,
            min_stable: 0.3,
            ramp_mw_per_min: 25.0,
            startup_hours: 2.0,
            startup_cost: 76800,
            marginal_cost_per_mwh: 86.4,
            fixed_om_per_month: 1316667,
            capital_cost: 358500000,
            build_months: 4,
            capacity_credit: 0.95,
            book_life_months: 360,
            siting: Anywhere,
        ),
        // Peaker (open-cycle gas turbine). Capital [P7-DE-004] [P7-US-013]: the
        // German range 450-700, midpoint 575 EUR/kW x (500 / 1,606 = 0.31133) =
        // 179.0, so 179 EUR/kW x 200,000 kW = 35,800,000. Fixed O&M [P7-EM-002]
        // [P7-US-015]: 21 EUR/kW-yr x (10.2 / 9.56 = 1.06695) = 22.41, so 22.4 x
        // 200,000 / 12 = 373,333. Marginal [P7-EM-013] [P7-EM-006] [P7-US-028]
        // [P7-US-031]: 8.018426 x 9.447 MMBtu/MWh = 75.750 fuel + VOM 2.4 =
        // 78.150 EUR/MWh x (150 / 42.07 = 3.56549) = 278.6, so 279. Start-up
        // (ruling 2, authoring judgment: no sourced local start-up; P7-US-032
        // needs a local start-up row): 5,000 x 278.64298 / 150 = 9,288, so
        // 9,290. Build 2 months (ruling 1, authoring judgment: no sourced local
        // duration).
        (
            kind: Peaker,
            capacity_mw: 200.0,
            min_stable: 0.2,
            ramp_mw_per_min: 40.0,
            startup_hours: 0.16666666666666666,
            startup_cost: 9290,
            marginal_cost_per_mwh: 279.0,
            fixed_om_per_month: 373333,
            capital_cost: 35800000,
            build_months: 2,
            capacity_credit: 0.95,
            book_life_months: 360,
            siting: Anywhere,
        ),
        // Solar [P7-DE-006] [P7-US-016]: the German ground-mounted range
        // 700-900, midpoint 800 EUR/kWp, per kW of AC capacity by the
        // Nunez de Balboa ratio of 500 MWp to 391 MWac [P7-ES-004] (authoring
        // judgment: DC to AC conversion) = 1,023.0 EUR/kWac x (500 / 1,502 =
        // 0.33289) = 340.6, so 341 EUR/kW x 300,000 kW = 102,300,000. Fixed
        // O&M [P7-DE-013] [P7-US-018]: 13.3 EUR/kWp-yr x 1.27877 = 17.008
        // EUR/kWac-yr x (20.0 / 20.23 = 0.98863) = 16.81, so 16.8 x 300,000 /
        // 12 = 420,000. Build 2 months (ruling 1, authoring judgment: no
        // sourced local duration).
        (
            kind: Solar,
            capacity_mw: 300.0,
            min_stable: 0.0,
            ramp_mw_per_min: 300.0,
            startup_hours: 0.0,
            startup_cost: 0,
            marginal_cost_per_mwh: 0.0,
            fixed_om_per_month: 420000,
            capital_cost: 102300000,
            build_months: 2,
            capacity_credit: 0.3,
            book_life_months: 300,
            siting: Anywhere,
        ),
        // Hydro. Capital [P7-EM-010] [P7-US-019]: the EU Reference Scenario's
        // reservoir hydro, 2,100 EUR2015/kW (pacing judgment: no inflation
        // adjustment; P7-EM-015, IRENA's 2,057 EUR/kW for Europe, corroborates
        // it) x (1,500 / 7,073 = 0.21207) = 445.4, so 445 EUR/kW x 800,000 kW =
        // 356,000,000. Fixed O&M [P7-EM-011] [P7-US-021]: 25.5 EUR/kW-yr x
        // (40.5 / 33.54 = 1.20751) = 30.79, so 30.8 x 800,000 / 12 =
        // 2,053,333. Start-up (ruling 2 with the hydro judgment, authoring
        // judgment: the CCGT marginal ratio): 1,000 x 86.41107 / 45 = 1,920.
        // Build 12 months (ruling 1, authoring judgment: no sourced local
        // duration).
        (
            kind: Hydro,
            capacity_mw: 800.0,
            min_stable: 0.0,
            ramp_mw_per_min: 100.0,
            startup_hours: 0.08333333333333333,
            startup_cost: 1920,
            marginal_cost_per_mwh: 0.0,
            fixed_om_per_month: 2053333,
            capital_cost: 356000000,
            build_months: 12,
            capacity_credit: 0.8,
            book_life_months: 600,
            siting: HydroSite(0.5),
        ),
        // Storage (lithium-ion, 4 hours). Capital [P7-DE-007] [P7-US-022]: the
        // German PV-coupled battery range 400-600, midpoint 500 EUR/kWh x 4 h =
        // 2,000 EUR/kW x (500 / 1,744 = 0.28670) = 573.4, so 573 EUR/kW x
        // 200,000 kW = 114,600,000. Fixed O&M (ruling 4, authoring judgment:
        // derived from [P7-DE-007] by NA kind relativity): 573.39 x the NA fixed
        // O&M / capital (6.0 / 500 = 0.012) = 6.88 x 200,000 / 12 = 114,667.
        // Build 2 months (ruling 1, authoring judgment: no sourced local
        // duration). Windows on the CET system clock (spec section 28.4): the
        // starter territory's net load is highest in the Spanish and Moroccan
        // evening, from about 19:00 to 22:00, after Gemasolar's solar output
        // fades, so discharge may start at 18:00; charging fills the night and
        // the solar midday before then.
        (kind: Battery, capacity_mw: 200.0, min_stable: 0.0, ramp_mw_per_min: 0.0,
         startup_hours: 0.0, startup_cost: 0, marginal_cost_per_mwh: 0.0,
         fixed_om_per_month: 114667, capital_cost: 114600000, build_months: 2,
         capacity_credit: 0.0, book_life_months: 180, siting: Anywhere,
         battery: Some((charge_mw: 200.0, energy_mwh: 800.0, charge_efficiency: 0.9,
                        discharge_efficiency: 1.0, discharge_start_hour: 18, charge_end_hour: 18))),
    ],
    // Construction markets (spec section 28.7.1), from the research note's
    // "Europe-Maghreb economic-zone proposal" and "Spain-Morocco contrast".
    // Zone 0, the regional default, is the catalog above; ids follow the
    // proposal's order. Each zone overrides only the kinds with whole-project
    // sources, and neither touches lines (no sourced Spanish or Moroccan line
    // row), physics, fuel, tariffs or currency. The contrast of record is the
    // like-for-like 2021 onshore wind pair: Morocco 17.0% dearer, 3 against 7
    // game months. The cross-era IRENA comparison (P7-ES-006 against
    // P7-MA-004) is recorded in the note but not used.
    economic_zones: (
        zones: [
            // Spain. Wind [P7-ES-001] [P7-US-001]: Iberdrola's Herrera II, 70e6
            // EUR / 63,000 kW = 1,111.1 EUR/kW x (1,000 / 1,489 = 0.67159) =
            // 746.2, so 746 EUR/kW x 300,000 kW = 223,800,000 (P7-ES-002,
            // Cofrentes at 1,060, corroborates). Build [P7-ES-003] [P7-US-002]:
            // Puylobo's 8 months x (3 / 9) = 2.67, so 3 months (ruling 1,
            // sourced; wind has no ceiling). Solar [P7-ES-004] [P7-US-016]:
            // Nunez de Balboa, at most 300e6 EUR / 391,000 kWac = 767.3 EUR/kW x
            // (500 / 1,502 = 0.33289) = 255.4, so 255 EUR/kW x 300,000 kW =
            // 76,500,000. Build [P7-ES-005] [P7-US-017]: 12 months x (2 / 12) =
            // 2 months (ruling 1, sourced; ceiling 3).
            (
                id: 1,
                name_key: "economic-zone-spain",
                plants: [
                    (kind: Wind, capital_cost: 223800000, build_months: 3),
                    (kind: Solar, capital_cost: 76500000, build_months: 2),
                ],
            ),
            // Morocco. Wind [P7-MA-001] [P7-US-001]: EBRD's Koudia Al Baida
            // repowering, 130e6 EUR / 100,000 kW = 1,300 EUR/kW x 0.67159 =
            // 873.1, so 873 EUR/kW x 300,000 kW = 261,900,000, 17.0% above
            // Spain. Build [P7-MA-002] [P7-US-002]: works from 2022-07-18 to
            // first injection by 2024-03-06, 597 days / 30.4375 = 19.61 months x
            // (3 / 9) = 6.54, so 7 months (ruling 1, sourced; P7-MA-003's
            // planned window paces to 7-8). Solar [P7-MA-005] [P7-FX-001]
            // [P7-FX-002] [P7-US-016]: Masen's Noor Ouarzazate IV, more than 750e6
            // MAD / 72,000 kW = 10,416.7 MAD/kW / (9.692 / 0.885206 = 10.94886
            // MAD per EUR) = 951.4 EUR/kW x 0.33289 = 316.7, so 317 EUR/kW x
            // 300,000 kW = 95,100,000. Build [P7-MA-006] [P7-US-017]: the
            // planned 9-12 months, midpoint 10.5 x (2 / 12) = 1.75, so 2 months
            // (ruling 1, sourced as planned; either end also gives 2).
            (
                id: 2,
                name_key: "economic-zone-morocco",
                plants: [
                    (kind: Wind, capital_cost: 261900000, build_months: 7),
                    (kind: Solar, capital_cost: 95100000, build_months: 2),
                ],
            ),
        ],
