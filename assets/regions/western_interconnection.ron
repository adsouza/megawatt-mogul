    // A summer peak late in the afternoon, and a steep evening ramp in every
    // season: as solar fades from about 15:00 to 19:00, net load climbs
    // sharply (the duck curve).
    climates: [(id: 1,
        shapes: [
            ("winter", [
            0.82, 0.78, 0.76, 0.75, 0.76, 0.80, 0.89, 0.98, 1.01, 1.00, 0.98, 0.96,
            0.94, 0.93, 0.93, 0.95, 1.01, 1.10, 1.14, 1.12, 1.08, 1.02, 0.94, 0.87,
        ]),
            ("summer", [
            0.80, 0.75, 0.72, 0.70, 0.70, 0.72, 0.77, 0.83, 0.89, 0.95, 1.00, 1.05,
            1.09, 1.13, 1.17, 1.20, 1.23, 1.25, 1.25, 1.20, 1.12, 1.03, 0.93, 0.85,
        ]),
            ("shoulder", [
            0.78, 0.74, 0.72, 0.71, 0.72, 0.76, 0.85, 0.93, 0.96, 0.96, 0.95, 0.94,
            0.93, 0.92, 0.92, 0.94, 0.98, 1.05, 1.12, 1.13, 1.08, 1.00, 0.91, 0.83,
        ]),
        ],
        month_shapes: ["winter", "winter", "shoulder", "shoulder", "shoulder", "summer", "summer", "summer", "shoulder", "shoulder", "shoulder", "winter"],
        monthly: [1.02, 0.97, 0.92, 0.88, 0.92, 1.02, 1.14, 1.14, 1.03, 0.92, 0.95, 1.03],
    )],
    demand_noise: (forecast_error: 0.03, error_persistence: 0.995),
    // Computed sun supplies latitude and longitude; clearer skies than the East.
    solar: (
        clearness_mean: [0.58, 0.62, 0.68, 0.73, 0.77, 0.81, 0.80, 0.79, 0.78, 0.72, 0.62, 0.56],
        clearness_sd: 0.13,
    ),
    // Usable river flow, the Pacific Northwest hydrograph: the Columbia is a
    // snowmelt river, so flow climbs through April to the spring freshet in
    // May and June, recedes through July and bottoms out from late summer
    // into autumn (September and October), before autumn rain and the
    // drafting of the storage reservoirs give moderate winter flows. Winter
    // water does not cover a full day at capacity, so the hydro schedule
    // (spec section 12) spends it on the evening peak.
    hydro: (monthly_flow: [0.85, 0.85, 0.95, 1.15, 1.45, 1.55, 1.2, 0.85, 0.65, 0.65, 0.75, 0.8]),
    frequency: (
        nominal_hz: 60.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        starting_tariff_per_mwh: 95.0,
        reference_tariff_per_mwh: 100.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
        reliability_target: 0.999,
        return_per_reliability: 2.0,
        return_per_cost_improvement: 0.05,
        reserve_margin: 0.2,
        strike_threshold: 0.005,
        strikes_to_revoke: 3,
        clean_months_to_expire: 3,
        frequency_band_hz: 0.2,
        frequency_violation_share: 0.05,
    ),
    satisfaction: (
        starting: 70.0,
        reliability_floor: 0.95,
        price_sensitivity: 2.0,
        smoothing: 0.2,
    ),
    lines: (cost_per_cell: 20000000, cells_per_month: 4, book_life_months: 600),
    // The Pacific Northwest: Seattle, Portland and Spokane, served by
    // Columbia River hydro, combined cycle and peakers.
    start: (
        year: 2027,
        month: 1,
        cash: 3000000000,
        // Seattle anchors the starting service territory.
        home_city: 15,
        connected_cities: [15, 16, 17],
        fleet: [
            // Grand Coulee anchors a compact, hydro-led starting fleet.
            (Hydro, -118.98, 47.95),
            // Combined cycle: Port Westward and Chehalis.
            (Ccgt, -123.05, 46.18),
            (Ccgt, -122.93, 46.66),
            // Peakers near Seattle, Portland and Spokane cover seasonal peaks.
            (Peaker, -122.20, 47.30),
