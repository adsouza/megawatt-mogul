    demand_noise: (forecast_error: 0.03, error_persistence: 0.995),
    // Regional cloud from Moscow's sunshine (VVC normals 1961-1990, as
    // tabulated by English Wikipedia "Climate of Moscow", citing
    // thermograph.ru and Pogoda.ru.net, read 2026-10-25: 33, 72, 128, 170,
    // 265, 279, 271, 238, 147, 78, 32 and 18 hours), as a share of the
    // possible hours on the 15th at 55.76 N (FAO-56 equations 24, 25 and 34)
    // and through the Angstrom-Prescott relation with the FAO-56 defaults
    // (Allen et al., FAO Irrigation and Drainage Paper 56, 1998, equation 35:
    // a = 0.25, b = 0.50), normalised to clear sky (0.75): (0.25 + 0.5 x
    // share) / 0.75. The dark, overcast winter is the cloudiest (December
    // 0.39 against June 0.69).
    solar: (
        clearness_mean: [0.43, 0.52, 0.57, 0.61, 0.69, 0.69, 0.68, 0.68, 0.6, 0.5, 0.42, 0.39],
        clearness_sd: 0.13,
    ),
    // Usable river flow: the spring flood on the Volga and Kama (at Volgograd
    // the Volga runs from 5,090 to 48,450 m3/s around a mean of 8,150:
    // English Wikipedia, "Volga", infobox discharge at Volgograd, citing
    // Rivers Network, read 2026-10-25) peaks in May, the Siberian rivers in
    // June, and Central Asia's snow- and glacier-fed rivers in summer; the
    // frozen rivers run lowest from December to March. The monthly factors
    // are an authoring judgment on that shape (no monthly long-term inflow or
    // hydro generation table was reached).
    hydro: (monthly_flow: [0.6, 0.55, 0.6, 0.95, 1.75, 1.6, 1.25, 1.0, 0.9, 0.85, 0.75, 0.65]),
    // North American protection and performance values at 50 Hz (Global
    // Constraints).
    frequency: (
        nominal_hz: 50.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    // Currency-neutral ratios as in North America; only the two tariffs are
    // local.
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        // Tariffs [P7-IPS-001] [P7-US-034]: Moscow's regulated single-rate
        // household tariff (gas-stove homes) from 2025-07-01, 7,870 RUB/MWh x
        // (95 / 135.6 = 0.70059) = 5,513.6, so 5,510 to start, and x (100 /
        // 135.6 = 0.73746) = 5,803.8, so a reference of 5,800 (the same 0.95
        // relation as shipped). Basis: P7-IPS-001 is Moscow's regulated
        // household tariff, while P7-US-034 is an all-sector average
        // (authoring judgment: basis differs from the US all-sector
        // reference; not re-based). The fuel proxy (ruling 19) scales by the
        // same 5,800 reference, so it inherits that basis.
        starting_tariff_per_mwh: 5510.0,
        reference_tariff_per_mwh: 5800.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
        reliability_target: 0.999,
        return_per_reliability: 2.0,
        return_per_cost_improvement: 0.05,
        reserve_margin: 0.2,
        strike_threshold: 0.005,
        strikes_to_revoke: 3,
        clean_months_to_expire: 3,
        frequency_band_hz: 0.2,
        frequency_violation_share: 0.05,
    ),
    satisfaction: (
        starting: 70.0,
        reliability_floor: 0.95,
        price_sensitivity: 2.0,
        smoothing: 0.2,
    ),
    // Lines. Cost [P7-IPS-012] [P7-US-033]: Minenergo's 2019 aggregated
    // price norms (superseded by Order No. 131 of 2024, which was not
    // reached; 2018 prices, excluding VAT) for a 500 kV single-circuit line
    // on lattice towers with three conductors per phase, 8,944 + 5,483 + 3 x
    // 1,225 = 18,102 thousand RUB/km x the line ratio (466,832 / 2,796,170 =
    // 0.16695) = 3,022,203, so 3,020,000 RUB/km x cell_km 59.917 =
    // 180,948,181 RUB per cell. Build speed (rulings 5 and 21, authoring
    // judgment: cell width is the note's cell_km): 201.07 km per month /
    // 59.917 km = 3.36, so 3 cells per month.
    lines: (cost_per_cell: 180948181, cells_per_month: 3, book_life_months: 600),
    // The Moscow core: Moscow, Tula and Tver.
    start: (
        year: 2027,
        month: 1,
        // Cash (tuned freely; scale from [P7-IPS-004]): the Eastern
