        // Start-up (ruling 2, authoring judgment: no sourced local start-up):
        // 1,000,000 x 580.383 / 10 = 58,038,348, so 58,000,000. Build 18
        // months (ruling 1, authoring judgment: no sourced local duration).
        (
            kind: Nuclear,
            capacity_mw: 1100.0,
            min_stable: 0.7,
            ramp_mw_per_min: 5.0,
            startup_hours: 48.0,
            startup_cost: 58000000,
            marginal_cost_per_mwh: 580.0,
