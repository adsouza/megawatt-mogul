            // steam and combined-cycle stations (authoring judgment).
            (Ccgt, 39.56111111, 55.58333333),
            (Ccgt, 36.77027778, 56.74305556),
            (Ccgt, 41.175, 57.45944444),
            (Ccgt, 39.7775, 54.03444444),
            (Ccgt, 38.2375, 54.08638889),
            (Ccgt, 32.04888889, 59.48583333),
