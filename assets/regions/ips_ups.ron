        // (106,320.22 / 1,166.67 = 91.13162) = 455,658,108,065, so
        // 456,000,000,000 RUB.
        cash: 456000000000,
        // Moscow anchors the starting service territory.
        home_city: 1,
        connected_cities: [1, 2, 3],
