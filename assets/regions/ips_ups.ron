        (kind: Wind, capacity_mw: 300.0, min_stable: 0.0, ramp_mw_per_min: 0.0, startup_hours: 0.0, startup_cost: 0, marginal_cost_per_mwh: 0.0, fixed_om_per_month: 51000000, capital_cost: 30600000000, build_months: 3, capacity_credit: 0.2, book_life_months: 300, siting: Anywhere),
