        // 600 = 3,337,205, so 3,340,000. Ramp (ruling 24): 6 x 230 / 600 = 2.3
        // MW/min. Build [P7-IPS-005] [P7-US-008]: the planned 39 to 50 months
        // (launch October 2025, commissioning in 2029); at the range's
        // midpoint, 44.5 months x (8 / 36) = 9.9, so 10 months (ruling 1,
        // sourced planned duration; the midpoint is an authoring judgment;
        // ceiling 12).
        (
            kind: Coal,
            capacity_mw: 230.0,
            min_stable: 0.4,
            ramp_mw_per_min: 2.3,
            startup_hours: 8.0,
            startup_cost: 3340000,
            marginal_cost_per_mwh: 1740.0,
            fixed_om_per_month: 69958333,
            capital_cost: 24380000000,
            build_months: 10,
            capacity_credit: 0.95,
            book_life_months: 480,
            siting: CoolingWater(0.5),
        ),
        // Combined cycle. Capital [P7-IPS-006] [P7-US-010]: the Udarnaya
