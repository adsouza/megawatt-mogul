    // CST industry/evening load; regional averages are illustrative tuning.
    climates: [(id:1,shapes:[
        ("winter",[0.72,0.68,0.65,0.64,0.64,0.68,0.78,0.9,1.0,1.04,1.05,1.03,1.0,1.0,1.02,1.04,1.08,1.15,1.2,1.18,1.1,1.0,0.9,0.8]),
        ("summer",[0.75,0.71,0.68,0.66,0.66,0.7,0.8,0.9,1.0,1.08,1.13,1.15,1.12,1.18,1.22,1.23,1.2,1.14,1.1,1.12,1.1,1.02,0.92,0.82]),
        ("shoulder",[0.7,0.66,0.64,0.63,0.64,0.68,0.76,0.85,0.9,0.92,0.93,0.94,0.94,0.94,0.95,0.96,0.98,1.0,0.99,0.96,0.91,0.85,0.78,0.73])],
        month_shapes:["winter","winter","shoulder","shoulder","shoulder","summer","summer","summer","shoulder","shoulder","shoulder","winter"],
        monthly:[1.0,0.92,0.95,0.92,0.95,1.0,1.08,1.08,1.0,0.95,0.97,1.02])],
    demand_noise:(forecast_error:0.03,error_persistence:0.995),
    frequency: (
        nominal_hz: 50.0,
        k_inertia: 5.0,
        k_damping: 0.2,
        normal_band_hz: 0.05,
        shed_below_hz: -0.5,
        blackout_below_hz: -1.5,
        blackout_after_shed_ticks: 30,
        curtail_above_hz: 0.5,
        trip_above_hz: 1.5,
        trip_after_ticks: 5,
        shed_stage_spacing_hz: 0.2,
        shed_step: 0.05,
    ),
    regulator: (
        storage_accreditation: [(2.0, 0.65), (4.0, 0.85), (6.0, 0.93), (8.0, 0.96)],
        satisfaction_target: 90.0,
        return_per_satisfaction_point: 0.0005,
        // Tariffs [P7-SC-005] [P7-US-034]: 679.869 CNY/MWh x (95 / 135.6 =
        // 0.70059) = 476.3, so 476 to start, and x (100 / 135.6 = 0.73746) =
        // 501.4, so a reference of 501 (the same 0.95 relation as shipped).
        // Basis: P7-SC-005 is the commercial and industrial single-part
        // 1-10 kV energy price, tax included, while P7-US-034 is an
        // all-sector average (authoring judgment: basis differs from the US
        // all-sector reference; not re-based). The fuel proxy (ruling 19)
        // scales by this same 501.378 reference, so it inherits that basis.
        starting_tariff_per_mwh: 476.0,
        reference_tariff_per_mwh: 501.0,
        base_return: 0.09,
        min_return: 0.07,
        max_return: 0.11,
        reliability_target: 0.999,
        return_per_reliability: 2.0,
        return_per_cost_improvement: 0.05,
        reserve_margin: 0.2,
        strike_threshold: 0.005,
        strikes_to_revoke: 3,
        clean_months_to_expire: 3,
        frequency_band_hz: 0.2,
        frequency_violation_share: 0.05,
    ),
    satisfaction: (
        starting: 70.0,
        reliability_floor: 0.95,
        price_sensitivity: 2.0,
        smoothing: 0.2,
    ),
    // [P8-GAME-AC] National line cost proxy 444,000 CNY/km × 26.95 km/cell; 201.07/26.95 ≈ 7 cells/month.
    lines:(cost_per_cell:11966000,cells_per_month:7,book_life_months:600),
    // [P8-GAME-DC] Explicit game tuning; no real project or currency conversion claim.
    hvdc:(rating_mw:1000.0,converter_cost:400000000,cost_per_cell:12000000,
        converter_build_months:4,ramp_mw_per_min:50.0,converter_loss:0.01,
        loss_per_cell:0.0002,book_life_months:600,designed_hours_per_year:4000.0),
    // Beijing, Tianjin, Langfang. National capital relativity [P7-SC-003]; freely tuned cash.
    start:(year:2027,month:1,cash:4760000000,home_city:1,connected_cities:[1,2,3],
        // North–Central fleet; schematic sites near named generating centres, all on separate cells.
        fleet:[(Coal,117.8,39.4),(Coal,116.4,40.3),
            (Ccgt,116.1,39.7),(Ccgt,117.5,39.1),(Ccgt,116.9,40.0),
            (Peaker,115.7,39.4),(Peaker,117.2,40.5)]),
)
