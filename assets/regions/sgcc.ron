        (id:27,name_key:"city-chengdu",lon:104.07,lat:30.57,base_load_mw:8500.0,zone:1,climate:1),
        (id:28,name_key:"city-chongqing",lon:106.55,lat:29.56,base_load_mw:9000.0,zone:1,climate:1),
